---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import InstrumentActions from '../../components/InstrumentActions';
import { supabase, hasSupabase } from '../../lib/supabase';
import { getInitials } from '../../lib/helpers';

const { id } = Astro.params;

if (!hasSupabase || !id) return Astro.redirect('/');

const { data: instrument } = await supabase
  .from('instruments')
  .select('*')
  .eq('id', id)
  .single();

if (!instrument) return Astro.redirect('/');

// Fetch ownership history
const { data: history } = await supabase
  .from('instrument_history')
  .select('*, users!inner(display_name, vanity_slug)')
  .eq('instrument_id', id)
  .order('date_from', { ascending: false });

// Fetch current owner
let owner: any = null;
if (instrument.current_owner_id) {
  const { data } = await supabase
    .from('users')
    .select('id, display_name, vanity_slug')
    .eq('id', instrument.current_owner_id)
    .single();
  owner = data;
}

// Fetch performances involving this instrument
const { data: performances } = await supabase
  .from('event_performances')
  .select('events!inner(id, title, venue, city, event_date), users!inner(display_name, vanity_slug), pieces(title)')
  .eq('instrument_id', id)
  .order('created_at', { ascending: false })
  .limit(20);

const instrumentName = `${instrument.maker || 'Unknown'} ${instrument.type}`;
const seoDescription = `${instrumentName}${instrument.maker_year ? `, c. ${instrument.maker_year}` : ''} — provenance, ownership history, and performance record on Irregular Pearl.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: instrumentName,
  description: instrument.provenance_story || seoDescription,
  brand: instrument.maker ? { '@type': 'Brand', name: instrument.maker } : undefined,
  url: Astro.url.href,
  category: `Musical Instrument / ${instrument.type}`,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.url.origin },
    { '@type': 'ListItem', position: 2, name: 'Instruments', item: `${Astro.url.origin}/instruments` },
    { '@type': 'ListItem', position: 3, name: instrumentName },
  ],
};
---
<Layout title={instrumentName} description={seoDescription} jsonLd={[jsonLd, breadcrumbLd]}>
  <Navbar />

  <div class="px-4 md:px-6 py-2 text-xs text-muted border-b border-border/50 bg-surface">
    <a href="/" class="hover:text-ink">Home</a>
    <span class="mx-1">›</span>
    <span class="text-muted">{instrumentName}</span>
  </div>

  <main class="max-w-[800px] mx-auto px-4 md:px-6 py-6 md:py-8">
    <!-- Hero photo area -->
    <div class="w-full h-56 md:h-72 rounded-xl bg-gradient-to-br from-[#D5C4B0] via-[#C9B89A] to-[#D5C4B0] flex items-center justify-center mb-6 relative overflow-hidden">
      <div class="absolute inset-0 bg-[#1C1917]/[0.04]"></div>
      <span class="text-7xl opacity-15 relative z-10">🎻</span>
    </div>

    <!-- Header -->
    <div class="mb-6">
      <span class="font-mono text-[11px] text-accent bg-[#FEF3C7] px-2.5 py-1 rounded-full uppercase tracking-wider inline-block mb-2">{instrument.type}</span>
      <h1 class="font-display italic text-2xl md:text-[32px] leading-tight mb-1">{instrumentName}</h1>
      <p class="text-[15px] text-muted">
        by <span class="text-ink font-medium">{instrument.maker || 'Unknown maker'}</span>
        {instrument.maker_year && <span>, c. {instrument.maker_year}</span>}
        {instrument.country_of_origin && <span> · {instrument.country_of_origin}</span>}
      </p>
      {owner && (
        <p class="text-sm text-muted mt-2">
          Current player:
          <a href={owner.vanity_slug ? `/@${owner.vanity_slug}` : `/profile/${owner.id}`} class="text-ink font-medium no-underline hover:underline ml-1">{owner.display_name}</a>
        </p>
      )}
      <InstrumentActions
        instrumentId={id}
        currentOwnerId={instrument.current_owner_id}
        onOwnershipChange={() => window.location.reload()}
        client:idle
      />
    </div>

    <!-- Provenance Story -->
    {instrument.provenance_story && (
      <div class="text-sm md:text-base text-[#57534E] leading-relaxed mb-8 space-y-3">
        {instrument.provenance_story.split('\n\n').map((p: string) => (
          <p>{p}</p>
        ))}
      </div>
    )}

    <!-- Ownership Timeline -->
    {history && history.length > 0 && (
      <section class="mb-8">
        <h2 class="font-display text-xl mb-5">Ownership History</h2>
        <div class="relative pl-10">
          <div class="absolute left-4 top-4 bottom-4 w-0.5 bg-border"></div>

          {/* Current owner */}
          {owner && (
            <div class="relative mb-6 flex gap-3 items-start">
              <div class="absolute -left-10 w-8 h-8 rounded-full bg-[#FEF3C7] border-2 border-accent flex items-center justify-center text-xs font-semibold text-accent z-10">
                {getInitials(owner.display_name)}
              </div>
              <div>
                <div class="text-sm font-medium text-ink">
                  <a href={owner.vanity_slug ? `/@${owner.vanity_slug}` : `/profile/${owner.id}`} class="text-ink no-underline hover:underline">{owner.display_name}</a>
                  <span class="text-[10px] bg-[#FEF3C7] text-accent px-2 py-0.5 rounded-full ml-2 font-medium">Current</span>
                </div>
                <div class="font-mono text-[11px] text-[#A8A29E]">
                  {history[0]?.date_from ? new Date(history[0].date_from).getFullYear() : '?'} – present
                </div>
                {history[0]?.notes && <div class="text-xs text-muted mt-0.5">{history[0].notes}</div>}
              </div>
            </div>
          )}

          {/* Historical owners */}
          {history.slice(owner ? 1 : 0).map((h: any) => (
            <div class="relative mb-6 flex gap-3 items-start">
              <div class="absolute -left-10 w-8 h-8 rounded-full bg-[#E8DDD3] flex items-center justify-center text-xs font-semibold text-muted z-10">
                {getInitials(h.users?.display_name || '?')}
              </div>
              <div>
                <div class="text-sm font-medium text-ink">
                  {h.users?.vanity_slug ? (
                    <a href={`/@${h.users.vanity_slug}`} class="text-ink no-underline hover:underline">{h.users.display_name}</a>
                  ) : (
                    <span>{h.users?.display_name || 'Unknown'}</span>
                  )}
                </div>
                <div class="font-mono text-[11px] text-[#A8A29E]">
                  {h.date_from ? new Date(h.date_from).getFullYear() : '?'} – {h.date_to ? new Date(h.date_to).getFullYear() : '?'}
                </div>
                {h.notes && <div class="text-xs text-muted mt-0.5">{h.notes}</div>}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Performance History -->
    {performances && performances.length > 0 && (
      <section class="mb-8">
        <h2 class="font-display text-xl mb-4">Performance History</h2>
        {performances.map((p: any) => (
          <div class="py-3 border-b border-[#F3F2F0] last:border-b-0">
            <div class="text-sm text-ink">{(p as any).events?.title}</div>
            <div class="text-xs text-muted">
              {(p as any).events?.venue}{(p as any).events?.city ? `, ${(p as any).events.city}` : ''}
              {' · '}
              {new Date((p as any).events?.event_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </div>
          </div>
        ))}
      </section>
    )}
  </main>
</Layout>
