---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { seedPieces } from '../data/seed';
import { musicTerms } from '../data/musicTerms';
import { opportunities } from '../data/opportunities';

const legacyQuery = Astro.url.searchParams.get('q');
if (legacyQuery) return Astro.redirect(`/pieces?q=${encodeURIComponent(legacyQuery)}`, 301);

const sections = [
  { href: '/residency', kicker: 'Program', title: 'Artist Residency', description: 'Supporting emerging artists through a guest concerto opportunity.', count: 'Annual program', link: 'Explore the residency' },
  { href: '/pieces', kicker: 'Repertoire', title: 'Classical music pieces', description: 'Piece pages, performer insights, editions, and recordings.', count: `${seedPieces.length} pieces`, link: 'Explore the pieces' },
  { href: '/opportunities', kicker: 'Career', title: 'Opportunities and Resources', description: 'Competitions, grants, awards, and summer festivals.', count: `${opportunities.length} programs`, link: 'Browse opportunities and resources' },
  { href: '/glossary', kicker: 'Reference', title: 'Music glossary', description: 'Musical terms, styles, and history, explained for musicians.', count: `${musicTerms.length} terms`, link: 'Browse the glossary' },
];

const homeLd = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: 'Irregular Pearl',
  description: 'A classical music knowledge platform for repertoire, career opportunities, music history terms, and instrumental upkeep.', url: Astro.url.origin,
  hasPart: sections.map((section) => ({ '@type': 'CollectionPage', name: section.title, description: section.description, url: `${Astro.url.origin}${section.href}` })),
  potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: `${Astro.url.origin}/pieces?q={search_term_string}` }, 'query-input': 'required name=search_term_string' },
};
const orgLd = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Irregular Pearl', url: Astro.url.origin, description: 'A non-profit reference for working classical musicians.', nonprofitStatus: 'NonprofitType' };
---
<Layout title="Home" description="A classical music knowledge platform for repertoire, career opportunities, music history terms, and instrumental upkeep." jsonLd={[homeLd, orgLd]}>
  <Navbar />
  <main class="home-shell">
    <header class="home-header">
      <h1>A place to learn about classical music, share what you know, and discover what it means to others.</h1>
      <p class="lede">Explore our program and reference collections.</p>
    </header>
    <section class="section-grid" aria-label="Explore Irregular Pearl">
      {sections.map((section, index) => (
        <a class="section-card" href={section.href}>
          <span class="section-number" aria-hidden="true">0{index + 1}</span>
          <span class="section-kicker">{section.kicker}</span>
          <h2>{section.title}</h2>
          <p>{section.description}</p>
          <span class="section-footer"><span class="section-count">{section.count}</span><span class="section-link">{section.link} <span aria-hidden="true">→</span></span></span>
        </a>
      ))}
    </section>
    <aside class="mission-note">
      <p>Irregular Pearl is a 501(c)(3) Charitable Organization headquartered California. EIN: 39-2985134</p>
      <a href="/who-we-are">Who we are →</a>
    </aside>
  </main>
</Layout>

<style>
  .home-shell { max-width: 1100px; margin: 0 auto; padding: 24px 16px 32px; }
  .home-header { max-width: 780px; margin-bottom: 24px; }
  .kicker, .section-kicker { color: var(--accent); font-size: 11px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; }
  .kicker { margin: 0 0 8px; }
  h1 { font-family: var(--font-serif); font-size: 26px; font-weight: 500; line-height: 1.25; margin: 0; }
  .lede { color: var(--muted); font-size: 14px; line-height: 1.55; margin: 12px 0 0; }
  .section-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: .5px solid var(--border-strong); border-left: .5px solid var(--border); }
  .section-card { position: relative; display: flex; flex-direction: column; gap: 8px; min-width: 0; padding: 16px; border-right: .5px solid var(--border); border-bottom: .5px solid var(--border); color: var(--ink); text-decoration: none; }
  .section-card:hover { background: var(--bg-tint); }
  .section-card:focus-visible { outline: 1px solid var(--accent); outline-offset: -3px; }
  .section-card:first-child { grid-column: auto; }
  .section-number { position: absolute; top: 16px; right: 16px; color: var(--tertiary); font: 11px var(--font-mono); }
  .section-kicker { padding-right: 24px; }
  h2 { font-family: var(--font-serif); font-size: 22px; font-weight: 500; line-height: 1.25; margin: 0; }
  .section-card > p { color: var(--muted); font-size: 13px; line-height: 1.55; margin: 0; }
  .section-footer { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 16px; margin-top: auto; padding-top: 8px; }
  .section-count { color: var(--tertiary); font-size: 12px; }
  .section-link { color: var(--accent); font-size: 12px; font-weight: 500; }
  .mission-note { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; padding-top: 16px; }
  .mission-note p { max-width: 680px; color: var(--muted); font-family: var(--font-serif); font-size: 13px; line-height: 1.55; margin: 0; }
  .mission-note a { flex: none; color: var(--ink); font-size: 13px; text-decoration: none; }
  .mission-note a:hover { color: var(--accent); }
  @media (min-width: 768px) { .home-shell { padding-inline: 32px; } }
  @media (max-width: 767px) {
    .section-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .section-card:first-child { grid-column: auto; }
    .section-card { padding: 12px; }
    h2 { font-size: 18px; }
    .section-number { top: 12px; right: 12px; }
    .mission-note { flex-direction: column; gap: 12px; }
  }
</style>
