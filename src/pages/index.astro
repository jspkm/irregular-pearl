---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PieceCard from '../components/PieceCard.astro';
import MostWanted from '../components/MostWanted';
import { seedPieces } from '../data/seed';
import { supabase, hasSupabase } from '../lib/supabase';
import { groupBy, mapFuzzyResults } from '../lib/helpers';

const query = Astro.url.searchParams.get('q')?.trim() || '';
const filter = Astro.url.searchParams.get('filter') || '';
const filterType = Astro.url.searchParams.get('type') || '';

interface DisplayPiece {
  id: string;
  title: string;
  composer_name: string;
  catalog_number: string | null;
  instruments: string[];
  era: string;
  difficulty: string | null;
  duration_minutes: number | null;
  description: string;
  edition_count: number;
}

function seedToDisplay(p: typeof seedPieces[0]): DisplayPiece {
  return { ...p, edition_count: p.editions.length };
}

let displayPieces: DisplayPiece[] = seedPieces.map(seedToDisplay);

if (query) {
  if (hasSupabase) {
    const piecesResult = await supabase.from('pieces')
      .select('id, title, composer_name, catalog_number, instruments, era, difficulty, duration_minutes, description')
      .textSearch('fts', query, { type: 'websearch' })
      .limit(20);

    const pieceData = piecesResult.data;
    if (pieceData && pieceData.length > 0) {
      displayPieces = pieceData.map((r: any) => {
        const seed = seedPieces.find(p => p.id === r.id);
        if (seed) return seedToDisplay(seed);
        return {
          id: r.id,
          title: r.title,
          composer_name: r.composer_name,
          catalog_number: r.catalog_number,
          instruments: r.instruments || [],
          era: r.era,
          difficulty: r.difficulty,
          duration_minutes: r.duration_minutes,
          description: r.description || '',
          edition_count: 0,
        };
      });
    } else {
      displayPieces = [];
    }

    if (displayPieces.length === 0) {
      const { data: fuzzyData } = await supabase.rpc('fuzzy_search', { search_query: query });
      if (fuzzyData && fuzzyData.length > 0) {
        const fuzzy = mapFuzzyResults(fuzzyData);
        if (fuzzy.pieceIds.length > 0) {
          const { data: fuzzyPieces } = await supabase.from('pieces')
            .select('id, title, composer_name, catalog_number, instruments, era, difficulty, duration_minutes, description')
            .in('id', fuzzy.pieceIds);
          if (fuzzyPieces) {
            displayPieces = fuzzyPieces.map((r: any) => {
              const seed = seedPieces.find(p => p.id === r.id);
              if (seed) return seedToDisplay(seed);
              return { ...r, instruments: r.instruments || [], description: r.description || '', edition_count: 0 };
            });
          }
        }
      }
    }

    if (!query.includes('{') && !query.includes('}')) {
      supabase.from('search_queries').insert({ query, result_count: displayPieces.length }).then(() => {});
    }
  } else {
    const q = query.toLowerCase();
    displayPieces = seedPieces.filter(p =>
      p.title.toLowerCase().includes(q) ||
      p.composer_name.toLowerCase().includes(q) ||
      p.instruments.some(i => i.toLowerCase().includes(q))
    ).map(seedToDisplay);
  }
} else if (filter) {
  if (filterType === 'composer') {
    displayPieces = seedPieces.filter(p => p.composer_name.toLowerCase().includes(filter.toLowerCase())).map(seedToDisplay);
  } else if (filterType === 'era') {
    displayPieces = seedPieces.filter(p => p.era.toLowerCase().includes(filter.toLowerCase())).map(seedToDisplay);
  } else {
    displayPieces = seedPieces.filter(p =>
      p.instruments.some(i => i.toLowerCase().includes(filter.toLowerCase()))
    ).map(seedToDisplay);
  }
}

const isFiltered = !!(query || filter);
const hasSearchResults = displayPieces.length > 0;

let totalPieceCount = seedPieces.length;
if (hasSupabase) {
  const { count } = await supabase.from('pieces').select('id', { count: 'exact', head: true });
  if (count) totalPieceCount = count;
}

const instrumentGroups: Record<string, number> = {};
for (const piece of seedPieces) {
  const inst = piece.instruments[0]?.startsWith('Voice') ? 'Voice' : piece.instruments[0] || 'Other';
  instrumentGroups[inst] = (instrumentGroups[inst] || 0) + 1;
}
const displayInstruments: { name: string; count: number; filter: string }[] = [];
let windsCount = 0;
for (const [name, count] of Object.entries(instrumentGroups)) {
  if (['Piano', 'Violin', 'Cello', 'Voice'].includes(name)) {
    displayInstruments.push({ name, count, filter: name });
  } else {
    windsCount += count;
  }
}
displayInstruments.push({ name: 'Winds & Other', count: windsCount, filter: 'flute,clarinet,guitar,string' });
displayInstruments.sort((a, b) => b.count - a.count);

const composerCounts: Record<string, number> = {};
for (const piece of seedPieces) {
  composerCounts[piece.composer_name] = (composerCounts[piece.composer_name] || 0) + 1;
}
const topComposers = Object.entries(composerCounts)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 8)
  .map(([name, count]) => ({ name, count, initial: name.split(' ').pop()?.[0] || '?' }));

const filteredGroups = isFiltered
  ? groupBy(displayPieces, p => p.instruments[0]?.startsWith('Voice') ? 'Voice' : p.instruments[0] || 'Other')
  : {};

const homeLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Irregular Pearl',
  description: `A collaborative platform for classical music knowledge. ${totalPieceCount.toLocaleString()} pieces with editions and recordings.`,
  url: Astro.url.origin,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${Astro.url.origin}/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Irregular Pearl',
  url: Astro.url.origin,
  description: 'A non-profit collaborative platform for classical music knowledge.',
  nonprofitStatus: 'NonprofitType',
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Classical Music Pieces',
  description: `${totalPieceCount.toLocaleString()} classical music works with editions and recordings`,
  numberOfItems: totalPieceCount,
  itemListElement: seedPieces.slice(0, 30).map((piece, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${Astro.url.origin}/piece/${piece.id}`,
    name: `${piece.title} by ${piece.composer_name}`,
  })),
};
---
<Layout title="Home" jsonLd={[homeLd, orgLd, itemListLd]}>
  <Navbar />

  {isFiltered ? (
    <main class="max-w-5xl mx-auto px-4 md:px-6 py-8">
      {query && !hasSearchResults && (
        <div class="text-center py-16 text-muted">
          <p class="text-lg mb-2">No results for "{query}"</p>
          <p class="text-sm">Try a different search. <a href="/" class="underline">Browse all pieces</a></p>
        </div>
      )}

      {hasSearchResults && (
        <div class="mb-6">
          <p class="text-sm text-muted">
            {query ? `Results for "${query}"` : `${displayPieces.length} pieces`}
            <a href="/" class="ml-2 text-accent no-underline hover:underline">← Back</a>
          </p>
        </div>
      )}

      {displayPieces.length > 0 && (
        <section class="mb-8">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {displayPieces.map((piece) => (
              <PieceCard
                id={piece.id}
                title={piece.title}
                composer_name={piece.composer_name}
                catalog_number={piece.catalog_number}
                instruments={piece.instruments}
                era={piece.era}
                difficulty={piece.difficulty}
                duration_minutes={piece.duration_minutes}
                description={piece.description}
                edition_count={piece.edition_count}
              />
            ))}
          </div>
        </section>
      )}
    </main>
  ) : (
    <main>
      <div class="text-center py-16 md:py-20">
        <h1 class="text-4xl md:text-5xl font-medium tracking-tight mb-3">IrregularPearl</h1>
        <p class="text-muted text-base md:text-lg">Classical music knowledge platform</p>
      </div>

      <div class="max-w-[960px] mx-auto px-4 md:px-6">
        <section class="mb-12">
          <h2 class="text-2xl font-medium tracking-tight mb-5">Explore</h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
            <a href="/browse/era" class="block bg-surface border border-border rounded-lg p-4 hover:border-accent transition-all no-underline">
              <div class="text-base font-medium text-ink">By Era</div>
              <div class="text-xs text-muted">Baroque to Contemporary</div>
            </a>
            <a href="/browse/form" class="block bg-surface border border-border rounded-lg p-4 hover:border-accent transition-all no-underline">
              <div class="text-base font-medium text-ink">By Form</div>
              <div class="text-xs text-muted">Sonatas, symphonies, and more</div>
            </a>
            {displayInstruments.slice(0, 4).map((inst) => (
              <a href={`/instrument/${encodeURIComponent(inst.filter.split(',')[0].toLowerCase())}`} class="block bg-surface border border-border rounded-lg p-4 hover:border-accent transition-all no-underline">
                <div class="text-base font-medium text-ink">{inst.name}</div>
                <div class="text-xs text-muted">{inst.count} pieces</div>
              </a>
            ))}
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5">
            {topComposers.map((c) => (
              <a href={`/composer/${encodeURIComponent(c.name)}`} class="flex items-center gap-3 bg-surface border border-border rounded-lg px-4 py-3 hover:border-muted transition-all no-underline">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#E8DDD3] to-[#F5E6D3] flex items-center justify-center font-medium text-base text-muted flex-shrink-0">{c.initial}</div>
                <div>
                  <div class="text-sm font-medium text-ink">{c.name.split(' ').pop()}</div>
                  <div class="text-[11px] text-muted">{c.count} pieces</div>
                </div>
              </a>
            ))}
          </div>
        </section>

        <MostWanted client:idle />
      </div>
    </main>
  )}

</Layout>
