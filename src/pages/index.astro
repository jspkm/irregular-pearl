---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { seedPieces } from '../data/seed';
import { supabase, hasSupabase } from '../lib/supabase';
import { mapFuzzyResults } from '../lib/helpers';

const query = Astro.url.searchParams.get('q')?.trim() || '';

interface ListPiece {
  id: string;
  title: string;
  composer_name: string;
  catalog_number: string | null;
}

function toListPiece(p: { id: string; title: string; composer_name: string; catalog_number: string | null }): ListPiece {
  return { id: p.id, title: p.title, composer_name: p.composer_name, catalog_number: p.catalog_number };
}

let pieces: ListPiece[] = [];

if (query) {
  if (hasSupabase) {
    const { data } = await supabase
      .from('pieces')
      .select('id, title, composer_name, catalog_number, created_at')
      .textSearch('fts', query, { type: 'websearch' })
      .limit(50);

    if (data && data.length > 0) {
      pieces = data.map(toListPiece);
    } else {
      const { data: fuzzyData } = await supabase.rpc('fuzzy_search', { search_query: query });
      if (fuzzyData && fuzzyData.length > 0) {
        const fuzzy = mapFuzzyResults(fuzzyData);
        if (fuzzy.pieceIds.length > 0) {
          const { data: fuzzyPieces } = await supabase
            .from('pieces')
            .select('id, title, composer_name, catalog_number')
            .in('id', fuzzy.pieceIds);
          if (fuzzyPieces) pieces = fuzzyPieces.map(toListPiece);
        }
      }
    }

    if (!query.includes('{') && !query.includes('}')) {
      supabase.from('search_queries').insert({ query, result_count: pieces.length }).then(() => {});
    }
  } else {
    const q = query.toLowerCase();
    pieces = seedPieces
      .filter(p =>
        p.title.toLowerCase().includes(q) ||
        p.composer_name.toLowerCase().includes(q) ||
        p.instruments.some(i => i.toLowerCase().includes(q))
      )
      .map(toListPiece);
  }
} else {
  if (hasSupabase) {
    const { data } = await supabase
      .from('pieces')
      .select('id, title, composer_name, catalog_number, created_at')
      .order('created_at', { ascending: false })
      .limit(100);
    if (data && data.length > 0) {
      pieces = data.map(toListPiece);
    } else {
      pieces = seedPieces.map(toListPiece);
    }
  } else {
    pieces = seedPieces.map(toListPiece);
  }
}

// In Focus: the most recently approved signed work (performer's note, interpretive school,
// practice note, or newly published piece). Returns null until the contributor approval
// pipeline exists. When it does, this queries across the signed-content tables and returns
// { piece_title, piece_id, kind, pull_quote, byline, byline_bio }.
//
// Rendered only when non-null. When null, the landing page flows navbar → list.
const inFocus: {
  piece_title: string;
  piece_id: string;
  kind: string;
  pull_quote: string;
  byline: string;
  byline_bio: string;
} | null = null;

const totalPieceCount = pieces.length > 0
  ? (hasSupabase
      ? (await supabase.from('pieces').select('id', { count: 'exact', head: true })).count ?? pieces.length
      : pieces.length)
  : seedPieces.length;

const homeLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Irregular Pearl',
  description: 'A reference for working classical musicians. Signed performer\'s notes on a small, curated catalog.',
  url: Astro.url.origin,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${Astro.url.origin}/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Irregular Pearl',
  url: Astro.url.origin,
  description: 'A non-profit reference for working classical musicians.',
  nonprofitStatus: 'NonprofitType',
};
---
<Layout title="Home" jsonLd={[homeLd, orgLd]}>
  <Navbar />

  <main class="max-w-[800px] mx-auto px-4 md:px-6">
    {query ? (
      <section class="py-10">
        <p class="text-sm text-muted mb-6">
          {pieces.length > 0
            ? `${pieces.length} result${pieces.length === 1 ? '' : 's'} for "${query}"`
            : `No results for "${query}"`}
          <a href="/" class="ml-3 text-accent no-underline hover:underline">← Back</a>
        </p>

        {pieces.length > 0 && (
          <ul class="ip-list">
            {pieces.map((p) => (
              <li class="ip-row">
                <a href={`/piece/${p.id}`} class="ip-row-link">
                  <span class="ip-row-title">{p.title}</span>
                  <span class="ip-row-composer">{p.composer_name}</span>
                  <span class="ip-row-catalog">{p.catalog_number ?? ''}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    ) : (
      <>
        <section class="text-center pt-16 md:pt-24 pb-6">
          <h1 class="font-display text-[30px] md:text-[34px] leading-[1.25] text-ink tracking-tight">
            A reference for working classical musicians.
          </h1>
          <p class="mt-3 text-[15px] text-muted">
            {totalPieceCount} pieces. One contributor. Growing slowly.
          </p>
        </section>

        {inFocus && (
          <section class="max-w-[720px] mx-auto py-10 md:py-12">
            <div class="text-[11px] font-medium uppercase tracking-[0.08em] text-accent">In focus</div>
            <h2 class="mt-3 font-display text-[22px] md:text-[26px] font-medium leading-[1.3] text-ink">
              <a href={`/piece/${inFocus.piece_id}`} class="no-underline text-ink hover:text-accent transition-colors">
                {inFocus.piece_title}
              </a>
            </h2>
            <blockquote class="mt-4 border-l-2 border-accent pl-5 font-display italic text-[18px] md:text-[20px] leading-[1.55] text-ink">
              {inFocus.pull_quote}
            </blockquote>
            <div class="mt-3 text-[14px]">
              <span class="font-medium text-ink">{inFocus.byline}</span>
              <span class="text-muted"> · {inFocus.byline_bio}</span>
            </div>
            <a href={`/piece/${inFocus.piece_id}`} class="mt-2 inline-block text-[14px] text-ink underline underline-offset-4 decoration-border hover:decoration-accent">
              Read the full note →
            </a>
          </section>
        )}

        <section class={`pb-16 ${inFocus ? 'pt-2' : 'pt-8 md:pt-10'}`}>
          <ul class="ip-list">
            {pieces.map((p) => (
              <li class="ip-row">
                <a href={`/piece/${p.id}`} class="ip-row-link">
                  <span class="ip-row-title">{p.title}</span>
                  <span class="ip-row-composer">{p.composer_name}</span>
                  <span class="ip-row-catalog">{p.catalog_number ?? ''}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </>
    )}
  </main>
</Layout>

<style>
  .ip-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 0.5px solid var(--color-border);
  }
  .ip-row {
    border-bottom: 0.5px solid var(--color-border);
  }
  .ip-row-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 180px 110px;
    align-items: baseline;
    gap: 16px;
    padding: 14px 4px;
    text-decoration: none;
    color: var(--color-ink);
    transition: background-color 120ms ease-out;
  }
  .ip-row-link:hover {
    background-color: var(--color-bg-tint);
  }
  .ip-row-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    line-height: 1.35;
    color: var(--color-ink);
  }
  .ip-row-composer {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-muted);
  }
  .ip-row-catalog {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
    text-align: right;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .ip-row-link {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto auto;
      gap: 4px 12px;
      padding: 12px 4px;
    }
    .ip-row-title {
      grid-column: 1 / -1;
      font-size: 16px;
    }
    .ip-row-composer {
      grid-column: 1;
    }
    .ip-row-catalog {
      grid-column: 2;
      justify-self: end;
    }
  }
</style>
