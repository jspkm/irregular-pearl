---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { getEventFull } from '../../lib/events';
import { getStaffUser } from '../../lib/admin';

const { id } = Astro.params;
const event = await getEventFull(id || '');

if (!event) return Astro.redirect('/events');

const staffUser = await getStaffUser(Astro.cookies);
const isStaff = !!staffUser;

const dateObj = new Date(event.event_date + 'T00:00:00');
const dateStr = dateObj.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
const timeStr = event.start_time ? event.start_time.slice(0, 5) : null;

const seoDescription = `${event.title} — ${event.venue || ''}${event.city ? `, ${event.city}` : ''} on ${dateStr}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  description: event.description || seoDescription,
  startDate: event.start_time
    ? `${event.event_date}T${event.start_time}`
    : event.event_date,
  location: event.venue ? {
    '@type': 'Place',
    name: event.venue,
    address: { '@type': 'PostalAddress', addressLocality: event.city, addressCountry: event.country },
  } : undefined,
  url: Astro.url.href,
  image: event.poster_url || undefined,
  offers: event.ticket_url ? {
    '@type': 'Offer',
    url: event.ticket_url,
    price: event.ticket_price || undefined,
  } : undefined,
  performer: event.performers?.filter(p => p.users).map(p => ({
    '@type': 'Person',
    name: p.users!.display_name,
  })),
};
---
<Layout title={event.title} description={seoDescription} jsonLd={jsonLd}>
  <Navbar />

  <div class="px-4 md:px-6 py-2 text-xs text-muted border-b border-border/50 bg-surface">
    <a href="/" class="hover:text-ink">Home</a>
    <span class="mx-1">&rsaquo;</span>
    <a href="/events" class="text-muted no-underline hover:underline">Events</a>
    <span class="mx-1">&rsaquo;</span>
    <span class="text-muted">{event.title}</span>
  </div>

  <main class="max-w-[800px] mx-auto px-4 md:px-6 py-6 md:py-8">
    {/* Status banner for non-approved events (visible to creator/staff via RLS) */}
    {event.status !== 'approved' && (
      <div class:list={["px-4 py-2 rounded-lg text-xs mb-4 border",
        event.status === 'queued' ? 'bg-[#FEFCE8] border-[#FDE68A] text-[#CA8A04]' : 'bg-[#FEF2F2] border-[#FECACA] text-[#DC2626]']}>
        {event.status === 'queued' ? 'This event is pending review.' : 'This event has been rejected.'}
        {event.moderation_note && <span class="ml-2 text-muted">Note: {event.moderation_note}</span>}
      </div>
    )}

    <div class="flex gap-6 mb-6">
      {/* Date column */}
      <div class="text-center flex-shrink-0 w-16">
        <div class="font-mono text-[11px] text-accent uppercase tracking-wider">
          {dateObj.toLocaleDateString('en-US', { month: 'short' })}
        </div>
        <div class="font-display text-3xl text-ink leading-tight">
          {dateObj.getDate()}
        </div>
        <div class="font-mono text-[10px] text-[#A8A29E]">
          {dateObj.getFullYear()}
        </div>
        {timeStr && <div class="font-mono text-xs text-muted mt-1">{timeStr}</div>}
      </div>

      {/* Event details */}
      <div class="flex-1">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-[10px] text-muted bg-bg border border-border px-2 py-0.5 rounded capitalize">
            {event.event_type}
          </span>
          {event.source !== 'user' && (
            <span class="text-[10px] text-[#A8A29E] bg-bg border border-border px-2 py-0.5 rounded">
              via {event.source}
            </span>
          )}
        </div>
        <h1 class="font-display italic text-2xl md:text-[28px] leading-tight mb-1">
          {event.title || 'Untitled Event'}
        </h1>
        {event.venue && (
          <p class="text-sm text-muted">
            {event.venue}{event.city ? `, ${event.city}` : ''}{event.country ? `, ${event.country}` : ''}
          </p>
        )}
      </div>
    </div>

    {/* Poster image */}
    {event.poster_url && (
      <div class="mb-6 rounded-lg overflow-hidden border border-border">
        <img src={event.poster_url} alt={`Poster for ${event.title}`} class="w-full max-h-[500px] object-contain bg-bg" />
      </div>
    )}

    {/* Ticket info */}
    {(event.ticket_price || event.ticket_url) && (
      <div class="flex items-center gap-3 mb-6 p-4 bg-[#FEF3C7]/30 border border-[#FDE68A]/50 rounded-lg">
        {event.ticket_price && (
          <span class="font-mono text-sm text-accent font-medium">{event.ticket_price}</span>
        )}
        {event.ticket_url && (
          <a href={event.ticket_url} class="text-sm text-accent no-underline hover:underline font-medium" target="_blank" rel="noopener">
            Get Tickets &rarr;
          </a>
        )}
      </div>
    )}

    {/* Description */}
    {event.description && (
      <p class="text-sm md:text-base text-[#57534E] leading-relaxed mb-6">{event.description}</p>
    )}

    {event.url && (
      <a href={event.url} class="text-sm text-accent no-underline hover:underline mb-6 inline-block" target="_blank" rel="noopener">Event website &rarr;</a>
    )}

    {/* Program / Performers */}
    {event.performers && event.performers.length > 0 && (
      <section class="mt-6">
        <h2 class="font-display text-xl mb-4">Program</h2>
        {event.performers.map((p) => (
          <div class="py-3 border-b border-[#F3F2F0] last:border-b-0">
            {p.pieces && (
              <a href={`/piece/${p.pieces.id}`} class="text-sm font-medium text-ink no-underline hover:underline">
                {p.pieces.title}
                {p.pieces.composer_name && <span class="text-muted font-normal"> — {p.pieces.composer_name}</span>}
              </a>
            )}
            <div class="flex gap-3 mt-1 text-xs text-muted">
              {p.users && (
                <a href={p.users.username ? `/@${p.users.username}` : '#'} class="text-muted no-underline hover:underline">
                  {p.users.display_name}
                </a>
              )}
              {p.instruments && (
                <span class="text-[#A8A29E]">
                  {p.instruments.maker} {p.instruments.type}
                </span>
              )}
            </div>
          </div>
        ))}
      </section>
    )}

    {/* Moderation audit trail (staff only) */}
    {isStaff && event.moderated_by && (
      <section class="mt-8 p-4 bg-bg border border-border rounded-lg text-xs text-muted">
        <div class="font-medium text-ink mb-1">Moderation Audit</div>
        <div>Status: <span class="capitalize font-medium">{event.status}</span></div>
        {event.moderated_at && <div>Moderated: {new Date(event.moderated_at).toLocaleString()}</div>}
        {event.moderation_note && <div>Note: {event.moderation_note}</div>}
      </section>
    )}
  </main>
</Layout>
