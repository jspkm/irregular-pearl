---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import EventCard from '../../components/EventCard.astro';
import EventCalendar from '../../components/EventCalendar';
import { getEventsBasic, getEventCities } from '../../lib/events';
import { supabase, hasSupabase } from '../../lib/supabase';

// Parse query params
const mode = Astro.url.searchParams.get('mode') === 'archive' ? 'archive' : 'upcoming';
const eventType = Astro.url.searchParams.get('type') || '';
const dateFilter = Astro.url.searchParams.get('date') || '';

// City: explicit param > Cloudflare IP geolocation > empty (all cities)
const cityParam = Astro.url.searchParams.get('city') || '';
const cfCity = Astro.request.headers.get('cf-ipcity') || '';
const city = cityParam || (cfCity && !Astro.url.searchParams.has('city') ? cfCity : '');
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));
const perPage = 20;

// Fetch events + cities in parallel
const [eventsResult, cities] = await Promise.all([
  getEventsBasic({
    mode: mode as 'upcoming' | 'archive',
    city: city || undefined,
    eventType: eventType || undefined,
    date: dateFilter || undefined,
    limit: perPage,
    offset: (page - 1) * perPage,
  }),
  getEventCities(),
]);

const { events, count } = eventsResult;
const totalPages = Math.ceil(count / perPage);

// Resolve performer names for each event (batch query)
let performersByEvent: Record<string, string[]> = {};
if (events.length > 0 && hasSupabase) {
  const eventIds = events.map(e => e.id);
  const { data: perfs } = await supabase
    .from('event_performances')
    .select('event_id, users(display_name)')
    .in('event_id', eventIds);
  if (perfs) {
    for (const p of perfs as Array<{ event_id: string; users: { display_name: string } | null }>) {
      if (p.users?.display_name) {
        if (!performersByEvent[p.event_id]) performersByEvent[p.event_id] = [];
        performersByEvent[p.event_id].push(p.users.display_name);
      }
    }
  }
}

const EVENT_TYPES = ['recital', 'concert', 'masterclass', 'competition', 'festival'];

const seoDescription = mode === 'archive'
  ? 'Past classical music events from the Irregular Pearl community.'
  : 'Upcoming classical music events — recitals, concerts, competitions, and masterclasses.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${mode === 'archive' ? 'Past' : 'Upcoming'} Events — Irregular Pearl`,
  description: seoDescription,
  url: Astro.url.href,
};
---
<Layout title="Events" description={seoDescription} jsonLd={jsonLd}>
  <Navbar />

  <div class="px-4 md:px-6 py-2 text-xs text-muted border-b border-border/50 bg-surface">
    <a href="/" class="hover:text-ink">Home</a>
    <span class="mx-1">&rsaquo;</span>
    <span class="text-muted">Events</span>
  </div>

  <main class="max-w-[900px] mx-auto px-4 md:px-6 py-6 md:py-8">
    {/* Header + submit CTA */}
    <div class="flex items-center justify-between mb-6">
      <h1 class="font-display italic text-2xl md:text-[28px]">
        {mode === 'archive' ? 'Past Events' : 'Upcoming Events'}
      </h1>
      <a
        href="/events/submit"
        class="text-xs font-body font-medium text-surface bg-accent hover:bg-accent-hover px-3 py-1.5 rounded-lg transition-colors no-underline"
      >
        Submit Event
      </a>
    </div>

    {/* Filters bar */}
    <div class="flex flex-wrap items-center gap-2 mb-4">
      {/* Upcoming / Archive toggle */}
      <div class="flex border border-border rounded-lg overflow-hidden text-xs mr-2">
        <a
          href={`/events${city ? `?city=${city}` : ''}${eventType ? `${city ? '&' : '?'}type=${eventType}` : ''}`}
          class:list={["px-3 py-1.5 no-underline transition-colors", mode === 'upcoming' ? 'bg-accent text-surface' : 'text-muted hover:text-ink']}
        >
          Upcoming
        </a>
        <a
          href={`/events?mode=archive${city ? `&city=${city}` : ''}${eventType ? `&type=${eventType}` : ''}`}
          class:list={["px-3 py-1.5 no-underline transition-colors", mode === 'archive' ? 'bg-accent text-surface' : 'text-muted hover:text-ink']}
        >
          Archive
        </a>
      </div>

      {/* Event type pills */}
      <a
        href={`/events?mode=${mode}${city ? `&city=${city}` : ''}`}
        class:list={["px-3 py-1 rounded-full text-xs no-underline border transition-colors",
          !eventType ? 'bg-accent text-surface border-accent' : 'text-muted border-border hover:border-muted']}
      >
        All
      </a>
      {EVENT_TYPES.map(t => (
        <a
          href={`/events?mode=${mode}&type=${t}${city ? `&city=${city}` : ''}`}
          class:list={["px-3 py-1 rounded-full text-xs no-underline border transition-colors capitalize",
            eventType === t ? 'bg-accent text-surface border-accent' : 'text-muted border-border hover:border-muted']}
        >
          {t}
        </a>
      ))}

      {/* City filter */}
      {cities.length > 0 && (
        <select
          onchange="window.location.href = this.value"
          class="ml-auto text-xs border border-border rounded-lg px-2 py-1.5 bg-surface text-muted focus:outline-none focus:border-accent"
        >
          <option value={`/events?mode=${mode}${eventType ? `&type=${eventType}` : ''}`} selected={!city}>
            All cities
          </option>
          {cities.map(c => (
            <option
              value={`/events?mode=${mode}&city=${encodeURIComponent(c)}${eventType ? `&type=${eventType}` : ''}`}
              selected={city === c}
            >
              {c}
            </option>
          ))}
        </select>
      )}
    </div>

    {/* Calendar toggle (client-side interactive) */}
    <EventCalendar client:load mode={mode} city={city} eventType={eventType} />

    {/* Date filter indicator */}
    {dateFilter && (
      <div class="flex items-center gap-2 mb-4 text-xs text-muted">
        <span>Showing events on {new Date(dateFilter + 'T00:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
        <a href={`/events?mode=${mode}${city ? `&city=${city}` : ''}${eventType ? `&type=${eventType}` : ''}`}
           class="text-accent no-underline hover:underline">Clear</a>
      </div>
    )}

    {/* Events list */}
    {events.length === 0 ? (
      <div class="text-center py-16 text-muted">
        <p class="text-sm mb-1">
          {mode === 'archive' ? 'No past events' : 'No upcoming events'}
        </p>
        <p class="text-xs">
          {mode === 'archive'
            ? 'Past events will appear here once events have passed.'
            : 'Events will appear here as musicians add their recitals, concerts, and masterclasses.'}
        </p>
      </div>
    ) : (
      <div class="space-y-3">
        {events.map((event) => (
          <EventCard
            event={event}
            muted={mode === 'archive'}
            performers={performersByEvent[event.id] || []}
          />
        ))}
      </div>
    )}

    {/* Pagination */}
    {totalPages > 1 && (
      <div class="flex justify-center gap-2 mt-8">
        {page > 1 && (
          <a
            href={`/events?mode=${mode}&page=${page - 1}${city ? `&city=${city}` : ''}${eventType ? `&type=${eventType}` : ''}`}
            class="px-3 py-1.5 text-xs border border-border rounded-lg text-muted hover:text-ink no-underline"
          >
            Previous
          </a>
        )}
        <span class="px-3 py-1.5 text-xs text-muted">
          Page {page} of {totalPages}
        </span>
        {page < totalPages && (
          <a
            href={`/events?mode=${mode}&page=${page + 1}${city ? `&city=${city}` : ''}${eventType ? `&type=${eventType}` : ''}`}
            class="px-3 py-1.5 text-xs border border-border rounded-lg text-muted hover:text-ink no-underline"
          >
            Next
          </a>
        )}
      </div>
    )}

    {/* Result count */}
    {count > 0 && (
      <p class="text-center text-[11px] text-[#A8A29E] mt-4">
        {count} {count === 1 ? 'event' : 'events'}{city ? ` in ${city}` : ''}{eventType ? ` (${eventType})` : ''}
      </p>
    )}
  </main>
</Layout>
