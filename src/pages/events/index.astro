---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { supabase, hasSupabase } from '../../lib/supabase';

let events: any[] = [];
if (hasSupabase) {
  const { data } = await supabase
    .from('events')
    .select('*, event_performances(users(display_name, username), pieces(title))')
    .gte('event_date', new Date().toISOString().split('T')[0])
    .neq('title', '')
    .order('event_date', { ascending: true })
    .limit(50);
  events = data || [];
}

const seoDescription = `Upcoming classical music events — recitals, concerts, competitions, and masterclasses from the Irregular Pearl community.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Events — Irregular Pearl',
  description: seoDescription,
  url: Astro.url.href,
};
---
<Layout title="Events" description={seoDescription} jsonLd={jsonLd}>
  <Navbar />

  <div class="px-4 md:px-6 py-2 text-xs text-muted border-b border-border/50 bg-surface">
    <a href="/" class="hover:text-ink">Home</a>
    <span class="mx-1">›</span>
    <span class="text-muted">Events</span>
  </div>

  <main class="max-w-[800px] mx-auto px-4 md:px-6 py-6 md:py-8">
    <h1 class="font-display italic text-2xl md:text-[28px] mb-6">Upcoming Events</h1>

    {events.length === 0 ? (
      <div class="text-center py-16 text-muted">
        <p class="text-sm mb-1">No upcoming events</p>
        <p class="text-xs">Events will appear here as musicians add their recitals, concerts, and masterclasses.</p>
      </div>
    ) : (
      <div class="space-y-3">
        {events.map((event) => (
          <a href={`/events/${event.id}`} class="flex gap-4 bg-surface border border-border rounded-xl p-5 hover:border-muted transition-all no-underline">
            <div class="text-center flex-shrink-0 w-14">
              <div class="font-mono text-[11px] text-accent uppercase tracking-wider">
                {new Date(event.event_date).toLocaleDateString('en-US', { month: 'short' })}
              </div>
              <div class="font-display text-[28px] text-ink leading-tight">
                {new Date(event.event_date).getDate()}
              </div>
              <div class="font-mono text-[10px] text-[#A8A29E]">
                {new Date(event.event_date).getFullYear()}
              </div>
            </div>
            <div class="flex-1">
              <span class="text-[10px] text-muted bg-bg border border-border px-2 py-0.5 rounded inline-block mb-1 capitalize">{event.event_type}</span>
              <div class="font-display text-lg text-ink mb-0.5">{event.title || 'Untitled Event'}</div>
              {event.venue && (
                <div class="text-xs text-muted">{event.venue}{event.city ? `, ${event.city}` : ''}</div>
              )}
              {event.event_performances?.length > 0 && (
                <div class="text-xs text-[#57534E] mt-1">
                  {event.event_performances.map((p: any) => p.users?.display_name).filter(Boolean).join(', ')}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    )}
  </main>
</Layout>
