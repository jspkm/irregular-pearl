---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PieceCard from '../../components/PieceCard.astro';
import { seedPieces } from '../../data/seed';
import { groupBy } from '../../lib/helpers';
import { getComposerPieces } from '../../lib/pieces';

const { name } = Astro.params;
const decodedName = decodeURIComponent(name || '');

// Find pieces by this composer (seed + Supabase merged)
const allPieces = await getComposerPieces(decodedName);

// Also check last-name match for seed pieces (existing behavior)
if (allPieces.length === 0) {
  const lastNamePieces = await getComposerPieces(
    seedPieces.find(p => p.composer_name.toLowerCase().endsWith(decodedName.toLowerCase()))?.composer_name || decodedName
  );
  if (lastNamePieces.length === 0) {
    return Astro.redirect('/');
  }
  allPieces.push(...lastNamePieces);
}

const pieces = allPieces;
const composerName = pieces[0].composer_name;

// Group by form (not instrument) for better browsing with 26K pieces
const byForm = groupBy(pieces, p => p.form || 'Other');

// Unique eras and forms
const eras = [...new Set(pieces.map(p => p.era))];
const forms = [...new Set(pieces.map(p => p.form))];
const instruments = [...new Set(pieces.flatMap(p => p.instruments))];

const seoDescription = `${composerName} on Irregular Pearl — browse ${pieces.length} pieces across ${instruments.join(', ')}. Compare editions and listen to recordings.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: composerName,
  description: `Classical music composer with ${pieces.length} pieces on Irregular Pearl`,
  url: Astro.url.href,
  mainEntityOfPage: {
    '@type': 'CollectionPage',
    name: `${composerName} — Works on Irregular Pearl`,
    description: seoDescription,
    url: Astro.url.href,
    isPartOf: {
      '@type': 'WebSite',
      name: 'Irregular Pearl',
      url: Astro.url.origin,
    },
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.url.origin },
    { '@type': 'ListItem', position: 2, name: composerName },
  ],
};
---
<Layout title={composerName} description={seoDescription} jsonLd={[jsonLd, breadcrumbLd]}>
  <Navbar />

  <div class="px-4 md:px-6 py-2 text-xs text-muted border-b border-border/50 bg-surface">
    <a href="/" class="hover:text-ink">Home</a>
    <span class="mx-1">›</span>
    <span class="text-muted">{composerName}</span>
  </div>

  <main class="max-w-5xl mx-auto px-4 md:px-6 py-8">
    <div class="mb-8">
      <h1 class="font-display text-3xl md:text-4xl italic mb-2">{composerName}</h1>
      <p class="text-muted text-sm md:text-base">
        {pieces.length} piece{pieces.length !== 1 ? 's' : ''} · {eras.join(', ')}
      </p>
      <div class="flex flex-wrap gap-1.5 mt-3">
        {instruments.map(i => (
          <a href={`/instrument/${encodeURIComponent(i.toLowerCase())}`} class="text-[11px] px-2.5 py-1 bg-bg border border-border rounded-full text-muted no-underline hover:border-accent">{i}</a>
        ))}
        {forms.map(f => (
          <span class="text-[11px] px-2.5 py-1 bg-bg border border-border rounded-full text-muted">{f}</span>
        ))}
      </div>
    </div>

    {Object.entries(byForm).map(([form, formPieces]) => (
      <details class="mb-8" open={formPieces.length <= 10}>
        <summary class="font-display text-xl mb-4 cursor-pointer hover:text-accent transition-colors list-none flex items-center gap-2">
          <svg class="w-4 h-4 text-muted transition-transform details-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          {form}
          <span class="text-sm font-sans text-muted font-normal">({formPieces.length})</span>
        </summary>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {formPieces.slice(0, 15).map((piece) => (
            <PieceCard
              id={piece.id}
              title={piece.title}
              composer_name={piece.composer_name}
              catalog_number={piece.catalog_number}
              instruments={piece.instruments}
              era={piece.era}
              difficulty={piece.difficulty || 'intermediate'}
              duration_minutes={piece.duration_minutes}
              description={piece.description}
            />
          ))}
        </div>
        {formPieces.length > 15 && (
          <p class="text-sm text-muted mt-3 italic">
            Showing 15 of {formPieces.length} {form.toLowerCase()} pieces.
          </p>
        )}
      </details>
    ))}
  </main>
</Layout>
