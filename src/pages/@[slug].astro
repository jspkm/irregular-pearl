---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ProfileOwnerBar from '../components/ProfileOwnerBar';
import ApplaudButton from '../components/ApplaudButton';
import { supabase, hasSupabase } from '../lib/supabase';
import { ACTIVITIES, normalizeSocialUrl, getSocialIcon, normalizeWebsiteUrl } from '../lib/helpers';

const { slug } = Astro.params;

if (!hasSupabase || !slug) return Astro.redirect('/');

const { data: user } = await supabase
  .from('users')
  .select('*')
  .eq('username', slug)
  .single();

if (!user) return Astro.redirect('/');

// Fetch instruments owned by this user (exclude blank entries)
const { data: instruments } = await supabase
  .from('instruments')
  .select('*')
  .eq('current_owner_id', user.id)
  .eq('privacy_level', 'public')
  .neq('type', '');

// Fetch recent activity
const { data: activity } = await supabase
  .from('activity_log')
  .select('activity, piece_id, created_at, pieces!inner(title)')
  .eq('user_id', user.id)
  .order('created_at', { ascending: false })
  .limit(10);

// Fetch performances
const { data: performances } = await supabase
  .from('performances')
  .select('id, event_name, venue, date, role, notes, notes_public')
  .eq('user_id', user.id)
  .neq('event_name', '')
  .order('date', { ascending: false })
  .limit(20);

// Fetch upcoming events this user is performing in
const { data: userEventPerfs } = await supabase
  .from('event_performances')
  .select('event_id')
  .eq('artist_id', user.id);

let upcomingEvents: { id: string; title: string; venue: string | null; city: string | null; event_date: string; event_type: string }[] = [];
if (userEventPerfs && userEventPerfs.length > 0) {
  const eventIds = userEventPerfs.map((p: { event_id: string }) => p.event_id);
  const today = new Date().toISOString().split('T')[0];
  const { data: events } = await supabase
    .from('events')
    .select('id, title, venue, city, event_date, event_type')
    .in('id', eventIds)
    .eq('status', 'approved')
    .gte('event_date', today)
    .order('event_date', { ascending: true })
    .limit(5);
  upcomingEvents = (events || []) as typeof upcomingEvents;
}

const trainingHistory = (user.training_history || []) as { year: string; title: string; detail: string }[];
const seoDescription = `${user.display_name} on Irregular Pearl — ${user.instrument || 'musician'}. ${user.bio?.slice(0, 120) || ''}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: user.display_name,
  description: user.bio || undefined,
  url: Astro.url.href,
  jobTitle: user.instrument ? `${user.instrument} player` : 'Musician',
  knowsAbout: 'Classical Music',
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.url.origin },
    { '@type': 'ListItem', position: 2, name: user.display_name },
  ],
};
---
<Layout title={user.display_name} description={seoDescription} jsonLd={[jsonLd, breadcrumbLd]}>
  <Navbar />

  <div class="px-4 md:px-6 py-2 text-xs text-muted border-b border-border/50 bg-surface">
    <a href="/" class="hover:text-ink">Home</a>
    <span class="mx-1">›</span>
    <span class="text-muted">{user.display_name}</span>
  </div>

  <div class="flex min-h-[calc(100vh-8rem)] max-w-[1100px] mx-auto">
    <!-- Main content (server-rendered for SEO) -->
    <main class="flex-1 min-w-0 px-4 md:px-8 py-6 md:py-8">
      <ProfileOwnerBar profileUserId={user.id} client:idle />
      <!-- Hero -->
      <div class="flex gap-5 mb-6">
        <div class="w-20 h-20 md:w-24 md:h-24 rounded-full bg-gradient-to-br from-[#E8DDD3] to-[#F5E6D3] flex items-center justify-center font-display italic text-3xl md:text-4xl text-muted flex-shrink-0">
          {user.display_name?.split(' ').map((n: string) => n[0]).join('').slice(0, 2)}
        </div>
        <div>
          <h1 class="font-display italic text-2xl md:text-[28px] leading-tight mb-1">{user.display_name}</h1>
          <p class="font-mono text-xs text-[#A8A29E] mb-2">irregularpearl.org/@{slug}</p>
          <div class="flex flex-wrap gap-2 items-center">
            {user.instrument && user.instrument.split(',').map((i: string) => i.trim()).filter(Boolean).map((inst: string) => (
              <span class="text-[11px] px-2.5 py-1 bg-[#FEF3C7] text-[#B45309] rounded-full font-medium">{inst}</span>
            ))}
            {user.level && (
              <span class="text-[11px] px-2.5 py-1 bg-green-50 text-green-700 rounded-full capitalize font-medium">{user.level}</span>
            )}
            {user.location && (
              <span class="text-xs text-muted">{user.location}</span>
            )}
          </div>
          <div class="mt-2">
            <ApplaudButton artistId={user.id} client:load />
          </div>
        </div>
      </div>

      <!-- Bio -->
      {user.bio && (
        <p class="text-sm md:text-base text-[#57534E] leading-relaxed mb-4 whitespace-pre-line">{user.bio}</p>
      )}

      <!-- Social & Website (inline, visible on all screens) -->
      {(user.website || (user.social_links && Object.values(user.social_links).some(Boolean))) && (
        <div class="flex flex-wrap items-center gap-3 mb-8">
          {user.social_links && Object.entries(user.social_links).filter(([, v]) => v).map(([platform, value]) => {
            const url = normalizeSocialUrl(platform, value as string);
            const icon = getSocialIcon(platform);
            return (
              <a href={url} target="_blank" rel="noopener noreferrer" title={platform}
                class="w-8 h-8 rounded-full bg-bg border border-border flex items-center justify-center text-muted hover:text-accent hover:border-accent transition-colors no-underline">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" set:html={icon} />
              </a>
            );
          })}
          {user.website && (
            <a href={normalizeWebsiteUrl(user.website)} class="text-xs text-accent no-underline hover:underline" target="_blank" rel="noopener">
              {user.website.replace(/^https?:\/\//, '')}
            </a>
          )}
        </div>
      )}

      <!-- Training Timeline -->
      {trainingHistory.length > 0 && (
        <section class="mb-8">
          <h2 class="font-display text-xl mb-4">Training</h2>
          <div class="relative pl-6">
            <div class="absolute left-[5px] top-1 bottom-1 w-0.5 bg-border"></div>
            {trainingHistory.map((item) => (
              <div class="relative mb-4">
                <div class="absolute -left-[19px] top-1.5 w-2.5 h-2.5 rounded-full bg-accent border-2 border-bg"></div>
                <div class="font-mono text-[11px] text-[#A8A29E] mb-0.5">{item.year}</div>
                <div class="text-sm text-ink">{item.title}</div>
                {item.detail && <div class="text-xs text-muted">{item.detail}</div>}
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Instruments -->
      {instruments && instruments.length > 0 && (
        <section class="mb-8">
          <h2 class="font-display text-xl mb-4">Instruments</h2>
          {instruments.map((inst: any) => (
            <a href={`/instruments/${inst.id}`} class="block bg-surface border border-border rounded-xl overflow-hidden mb-4 hover:border-muted transition-all no-underline">
              <div class="h-40 bg-gradient-to-br from-[#E8DDD3] via-[#D5C4B0] to-[#C9B89A] flex items-center justify-center">
                <span class="text-5xl opacity-15">🎻</span>
              </div>
              <div class="p-4">
                <div class="font-mono text-[11px] text-muted uppercase tracking-wider mb-1">{inst.maker || 'Unknown maker'}</div>
                <div class="font-display text-lg text-ink">{inst.type}, {inst.maker_year ? `c. ${inst.maker_year}` : 'date unknown'}</div>
                {inst.country_of_origin && <div class="font-mono text-xs text-muted mb-2">{inst.country_of_origin}</div>}
                {inst.provenance_story && (
                  <p class="text-xs text-muted leading-relaxed line-clamp-2">{inst.provenance_story.slice(0, 150)}...</p>
                )}
              </div>
            </a>
          ))}
        </section>
      )}
      <!-- Upcoming Events (from event_performances join) -->
      {upcomingEvents.length > 0 && (
        <section class="mb-8">
          <h2 class="font-display text-xl mb-4">Upcoming Events</h2>
          <div class="space-y-2">
            {upcomingEvents.map((ev) => (
              <a href={`/events/${ev.id}`} class="flex items-center gap-3 bg-surface border border-border rounded-lg px-5 py-3 no-underline hover:border-muted transition-colors">
                <div class="text-center flex-shrink-0 w-10">
                  <div class="font-mono text-[10px] text-accent uppercase">
                    {new Date(ev.event_date + 'T00:00:00').toLocaleDateString('en-US', { month: 'short' })}
                  </div>
                  <div class="font-display text-lg text-ink leading-tight">
                    {new Date(ev.event_date + 'T00:00:00').getDate()}
                  </div>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-medium text-ink truncate">{ev.title}</div>
                  {ev.venue && <div class="text-xs text-muted truncate">{ev.venue}{ev.city ? `, ${ev.city}` : ''}</div>}
                </div>
                <span class="text-[10px] text-muted bg-bg border border-border px-2 py-0.5 rounded capitalize flex-shrink-0">{ev.event_type}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Performances -->
      {performances && performances.length > 0 && (
        <section class="mb-8">
          <h2 class="font-display text-xl mb-4">Performances</h2>
          <div class="space-y-2">
            {performances.map((p: any) => (
              <div class="bg-surface border border-border rounded-lg px-5 py-3">
                <div class="text-sm font-medium text-ink">
                  {p.event_name}
                  {p.role && (
                    <span class={`ml-2 text-[10px] px-1.5 py-0.5 rounded ${p.role === 'performed' ? 'bg-[#FEF3C7] text-[#B45309]' : 'bg-blue-50 text-blue-700'}`}>
                      {p.role === 'performed' ? 'Performed' : 'Attended'}
                    </span>
                  )}
                </div>
                <div class="text-xs text-muted">{p.venue && `${p.venue} · `}{p.date || ''}</div>
                {p.notes && p.notes_public && (
                  <div class="mt-2 text-xs text-[#57534E] leading-relaxed border-t border-[#F3F2F0] pt-2 whitespace-pre-line">
                    {p.notes}
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>
      )}
    </main>

    <!-- Sidebar -->
    <aside class="hidden md:block w-80 flex-shrink-0 bg-surface border-l border-border px-5 py-6">
      {activity && activity.length > 0 && (
        <div class="mb-6">
          <h2 class="text-[15px] font-semibold mb-3">Recent Activity</h2>
          {activity.map((a: any) => {
            const act = ACTIVITIES.find(x => x.type === a.activity);
            return (
              <div class="py-2 border-b border-[#F3F2F0] last:border-b-0">
                <div class="text-xs text-[#57534E]">
                  <span class="mr-1">{act?.emoji}</span>
                  {act?.label || a.activity}
                  {' '}
                  <a href={`/piece/${a.piece_id}`} class="font-medium text-ink no-underline hover:underline">{(a as any).pieces?.title}</a>
                </div>
                <div class="text-[11px] text-[#A8A29E] mt-0.5">
                  {new Date(a.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                </div>
              </div>
            );
          })}
        </div>
      )}

    </aside>
  </div>
</Layout>
