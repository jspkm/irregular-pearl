---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ProfileOwnerBar from '../components/ProfileOwnerBar';
import { supabase, hasSupabase } from '../lib/supabase';
import { normalizeSocialUrl, getSocialIcon, normalizeWebsiteUrl } from '../lib/helpers';

const { slug } = Astro.params;

if (!hasSupabase || !slug) return Astro.redirect('/');

const { data: user } = await supabase
  .from('users')
  .select('*')
  .eq('username', slug)
  .single();

if (!user) return Astro.redirect('/');

const seoDescription = `${user.display_name} on Irregular Pearl — ${user.instrument || 'musician'}. ${user.bio?.slice(0, 120) || ''}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: user.display_name,
  description: user.bio || undefined,
  url: Astro.url.href,
  jobTitle: user.instrument ? `${user.instrument} player` : 'Musician',
  knowsAbout: 'Classical Music',
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.url.origin },
    { '@type': 'ListItem', position: 2, name: user.display_name },
  ],
};
---
<Layout title={user.display_name} description={seoDescription} jsonLd={[jsonLd, breadcrumbLd]}>
  <Navbar />

  <div class="px-4 md:px-6 py-2 text-xs text-muted border-b border-border/50 bg-surface">
    <a href="/" class="hover:text-ink">Home</a>
    <span class="mx-1">›</span>
    <span class="text-muted">{user.display_name}</span>
  </div>

  <main class="max-w-190 mx-auto px-4 md:px-8 py-8 md:py-12">
    <ProfileOwnerBar profileUserId={user.id} client:idle />

    <div class="flex gap-5 mb-6">
      <div class="w-20 h-20 md:w-24 md:h-24 rounded-full bg-gradient-to-br from-[#E8DDD3] to-[#F5E6D3] flex items-center justify-center font-display italic text-3xl md:text-4xl text-muted flex-shrink-0">
        {user.display_name?.split(' ').map((n: string) => n[0]).join('').slice(0, 2)}
      </div>
      <div>
        <h1 class="font-display italic text-2xl md:text-[28px] leading-tight mb-1">{user.display_name}</h1>
        <p class="font-mono text-xs text-tertiary mb-2">irregularpearl.org/@{slug}</p>
        <div class="flex flex-wrap gap-2 items-center">
          {user.instrument && user.instrument.split(',').map((i: string) => i.trim()).filter(Boolean).map((inst: string) => (
            <span class="text-[11px] px-2.5 py-1 bg-accent-soft text-accent rounded-full font-medium">{inst}</span>
          ))}
          {user.level && (
            <span class="text-[11px] px-2.5 py-1 bg-green-50 text-green-700 rounded-full capitalize font-medium">{user.level}</span>
          )}
          {user.location && (
            <span class="text-xs text-muted">{user.location}</span>
          )}
        </div>
      </div>
    </div>

    {user.bio && (
      <p class="text-sm md:text-base text-muted leading-relaxed mb-4 whitespace-pre-line">{user.bio}</p>
    )}

    {(user.website || (user.social_links && Object.values(user.social_links).some(Boolean))) && (
      <div class="flex flex-wrap items-center gap-3 mb-8">
        {user.social_links && Object.entries(user.social_links).filter(([, v]) => v).map(([platform, value]) => {
          const url = normalizeSocialUrl(platform, value as string);
          const icon = getSocialIcon(platform);
          return (
            <a href={url} target="_blank" rel="noopener noreferrer" title={platform}
              class="w-8 h-8 rounded-full bg-bg border border-border flex items-center justify-center text-muted hover:text-accent hover:border-accent transition-colors no-underline">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" set:html={icon} />
            </a>
          );
        })}
        {user.website && (
          <a href={normalizeWebsiteUrl(user.website)} class="text-xs text-accent no-underline hover:underline" target="_blank" rel="noopener">
            {user.website.replace(/^https?:\/\//, '')}
          </a>
        )}
      </div>
    )}
  </main>
</Layout>
