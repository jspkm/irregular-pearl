---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { musicTerms } from '../../data/musicTerms';
import { musicPeriods } from '../../data/musicPeriods';

const seoDescription = 'A musician’s glossary of historical styles, forms, performance practice, theory, and compositional techniques.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Irregular Pearl music glossary',
  description: seoDescription,
  url: Astro.url.href,
  hasDefinedTerm: musicTerms.map((entry) => ({
    '@type': 'DefinedTerm',
    name: entry.term,
    description: entry.definition,
    url: `${Astro.url.origin}/glossary/era/${entry.historicalPeriodId}#term-${entry.id}`,
  })),
};
---
<Layout title="Music glossary" description={seoDescription} jsonLd={jsonLd}>
  <Navbar />

  <main class="glossary-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><span>Music glossary</span>
    </nav>

    <header class="glossary-header">
      <p class="kicker">Reference</p>
      <h1>Music glossary</h1>
      <p class="lede">Historical styles, forms, techniques, and performance-practice ideas—defined for musicians and connected to repertoire.</p>
    </header>

    <section class="period-catalog" aria-labelledby="period-catalog-title">
      <div class="period-heading">
        <p class="kicker">Chronological catalog</p>
        <h2 id="period-catalog-title">Music history by century</h2>
      </div>
      <div class="period-list">
        {musicPeriods.map((period) => (
          <article id={period.id} class="period-row">
            <a class="period-link" href={`/glossary/era/${period.id}`}>
              <span class="period-span">{period.span}</span>
              <span class="period-label">
                <strong>{period.title}</strong>
                <small>{period.description}</small>
              </span>
              <span class="period-toggle" aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </section>

  </main>
</Layout>

<style>
  .glossary-shell { max-width: 960px; margin: 0 auto; padding: 32px 16px 64px; }
  .breadcrumbs { display: flex; gap: 8px; align-items: center; color: var(--muted); font-size: 12px; margin-bottom: 48px; }
  .breadcrumbs a { color: var(--muted); text-decoration: none; }
  .glossary-header { max-width: 680px; margin-bottom: 32px; }
  .kicker { color: var(--accent); font-size: 11px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; margin: 0 0 8px; }
  h1 { font-family: var(--font-serif); font-size: 34px; font-weight: 500; line-height: 1.25; margin: 0 0 12px; }
  .lede { color: var(--muted); font-size: 16px; line-height: 1.55; margin: 0; }
  .period-catalog { margin-bottom: 48px; }
  .period-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 14px; }
  .period-heading .kicker { margin: 0; }
  .period-heading h2 { margin: 0; font-family: var(--font-serif); font-size: 24px; font-weight: 500; }
  .period-list { border-top: .5px solid var(--border-strong); }
  .period-row { scroll-margin-top: 96px; border-bottom: .5px solid var(--border); }
  .period-row:target { margin-inline: -12px; padding-inline: 12px; background: var(--accent-soft); }
  .period-link { display: grid; grid-template-columns: 140px minmax(0, 1fr) 24px; gap: 24px; align-items: start; padding: 18px 0; color: var(--ink); text-decoration: none; }
  .period-link:hover .period-label strong { color: var(--accent); }
  .period-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .period-span { color: var(--accent); font-size: 12px; font-weight: 500; letter-spacing: .03em; }
  .period-label { display: grid; gap: 4px; }
  .period-label strong { font-family: var(--font-serif); font-size: 19px; font-weight: 500; transition: color .15s ease; }
  .period-label small { color: var(--muted); font-size: 13px; line-height: 1.5; }
  .period-toggle { color: var(--accent); font-size: 17px; line-height: 1; text-align: center; transition: transform .15s ease; }
  .period-link:hover .period-toggle { transform: translateX(3px); }
  @media (min-width: 768px) { .glossary-shell { padding: 40px 32px 80px; } }
  @media (max-width: 640px) {
    .breadcrumbs { margin-bottom: 32px; }
    .period-heading { display: block; }
    .period-heading .kicker { margin-bottom: 6px; }
    .period-link { grid-template-columns: 1fr 24px; gap: 6px 12px; }
    .period-span { grid-column: 1; }
    .period-label { grid-column: 1; }
    .period-toggle { grid-column: 2; grid-row: 1 / span 2; }
  }
</style>
