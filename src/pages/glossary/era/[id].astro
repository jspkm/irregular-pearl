---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import { musicPeriods, type MusicPeriod } from '../../../data/musicPeriods';
import { musicPeriodProfilesById, type MusicPeriodProfile } from '../../../data/musicPeriodProfiles';
import { musicTerms } from '../../../data/musicTerms';
import { musicTheoryByPeriod } from '../../../data/musicTheoryByPeriod';
import EraTerms from '../../../components/EraTerms';
import EraKnowledge from '../../../components/EraKnowledge';
import SectionComments from '../../../components/SectionComments';

export const prerender = true;

export function getStaticPaths() {
  return musicPeriods.map((period) => ({
    params: { id: period.id },
    props: { period, profile: musicPeriodProfilesById.get(period.id)! },
  }));
}

interface Props { period: MusicPeriod; profile: MusicPeriodProfile }
const { period, profile } = Astro.props;
const glossaryTerms = musicTerms
  .filter((term) => term.historicalPeriodId === period.id || profile.exampleTerms.some(name => name.toLowerCase() === term.term.toLowerCase()))
  .sort((a, b) => a.term.localeCompare(b.term));
const theoryConcepts = musicTheoryByPeriod[period.id] ?? [];
const title = `${period.title} — ${period.span}`;
const description = `${period.description} Explore terminology, composers, artistic context, historical events, and inventions from the era.`;
---
<Layout title={title} description={description}>
  <Navbar />
  <main class="era-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><a href="/glossary">Music glossary</a><span aria-hidden="true">/</span><span>{period.title}</span>
    </nav>

    <header class="era-header">
      <p class="kicker">{period.span}</p>
      <h1>{period.title}</h1>
      <div class="era-summary"><SectionComments client:load subjectType="glossary_era_summary" subjectKey={period.id} summaryText={period.description} /></div>
    </header>

    <section class="era-section" aria-labelledby="terms-title">
      <p class="section-number">01</p>
      <div>
        <EraTerms client:load eraId={period.id} terms={glossaryTerms} />
      </div>
    </section>

    <section class="era-section" aria-labelledby="characteristics-title">
      <p class="section-number">02</p>
      <div>
        <EraKnowledge client:load eraId={period.id} kind="characteristic" entries={profile.characteristics.map(name => ({ name, description: '' }))} />
        <div class="characteristic-comments"><SectionComments client:load subjectType="glossary_era_characteristics" subjectKey={period.id} /></div>
      </div>
    </section>

    <section class="era-section" aria-labelledby="theory-title">
      <p class="section-number">03</p>
      <div>
        <EraKnowledge client:load eraId={period.id} kind="theory" entries={theoryConcepts} />
      </div>
    </section>

    <div class="people-grid">
      <section>
        <p class="section-number">04</p>
        <h2>Famous composers</h2>
        <ul>{profile.composers.map((name) => <li><a href={`/composer/${encodeURIComponent(name)}`}>{name}</a></li>)}</ul>
      </section>
      <section>
        <p class="section-number">05</p>
        <h2>Writers and poets</h2>
        <ul>{profile.writers.map((name) => <li>{name}</li>)}</ul>
      </section>
      <section>
        <p class="section-number">06</p>
        <h2>Visual artists</h2>
        <ul>{profile.artists.map((name) => <li>{name}</li>)}</ul>
      </section>
    </div>

    <div class="context-grid">
      <section>
        <p class="section-number">07</p>
        <h2>Key historical event</h2>
        <p>{profile.historicEvent}</p>
      </section>
      <section>
        <p class="section-number">08</p>
        <h2>Notable invention</h2>
        <p>{profile.invention}</p>
      </section>
    </div>

    <nav class="era-navigation" aria-label="Browse music history eras">
      <a href="/glossary">← All eras</a>
    </nav>
  </main>
</Layout>

<style>
  .era-shell { max-width: 960px; margin: 0 auto; padding: 32px 16px 72px; }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 48px; color: var(--muted); font-size: 12px; }
  .breadcrumbs a { color: var(--muted); text-decoration: none; }
  .era-header { position: relative; max-width: 760px; margin-bottom: 52px; padding-right: 44px; }
  .kicker, .section-number { margin: 0 0 8px; color: var(--accent); font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  h1 { margin: 0 0 14px; font-family: var(--font-serif); font-size: clamp(38px, 7vw, 62px); font-weight: 500; line-height: 1.05; }
  .era-summary { margin: 0; color: var(--muted); font-size: 17px; line-height: 1.65; }
  h2 { margin: 0 0 16px; font-family: var(--font-serif); font-size: 23px; font-weight: 500; }
  .era-section { display: grid; grid-template-columns: 70px minmax(0, 1fr); gap: 24px; padding: 30px 0; border-top: .5px solid var(--border-strong); }
  .characteristic-comments { position: relative; height: 28px; margin-top: 12px; }
  .era-section ul, .people-grid ul { margin: 0; padding-left: 20px; color: var(--muted); line-height: 1.8; }
  .people-grid li a { color: var(--ink); text-decoration: none; }
  .people-grid li a:hover { color: var(--accent); }
  .term-grid { display: flex; flex-wrap: wrap; gap: 8px; }
  .term-grid a, .term-grid > span { padding: 8px 11px; border: .5px solid var(--border); border-radius: 999px; color: var(--ink); font-size: 12px; text-decoration: none; }
  .term-grid a { color: var(--accent); background: var(--accent-soft); }
  .term-grid a span { margin-left: 6px; }
  .see-all-terms { display: inline-flex; gap: 8px; align-items: center; margin-top: 18px; color: var(--accent); font-size: 13px; font-weight: 500; text-decoration: none; }
  .see-all-terms:hover span { transform: translateX(3px); }
  .see-all-terms span { transition: transform .15s ease; }
  .theory-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; margin: 0; border-top: .5px solid var(--border); }
  .theory-grid div { padding: 16px 18px 16px 0; border-bottom: .5px solid var(--border); }
  .theory-grid div:nth-child(odd) { padding-right: 24px; }
  .theory-grid div:nth-child(even) { padding-left: 24px; border-left: .5px solid var(--border); }
  .theory-grid dt { margin-bottom: 5px; color: var(--ink); font-family: var(--font-serif); font-size: 16px; font-weight: 500; }
  .theory-grid dd { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.55; }
  .people-grid, .context-grid { display: grid; gap: 0; border-top: .5px solid var(--border-strong); }
  .people-grid { grid-template-columns: repeat(3, 1fr); }
  .context-grid { grid-template-columns: repeat(2, 1fr); }
  .people-grid section, .context-grid section { padding: 28px; border-right: .5px solid var(--border); }
  .people-grid section:last-child, .context-grid section:last-child { border-right: 0; }
  .context-grid p:last-child { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.65; }
  .era-navigation { margin-top: 42px; padding-top: 20px; border-top: .5px solid var(--border); }
  .era-navigation a { color: var(--accent); font-size: 13px; text-decoration: none; }
  @media (min-width: 768px) { .era-shell { padding: 40px 32px 88px; } }
  @media (max-width: 720px) {
    .people-grid, .context-grid { grid-template-columns: 1fr; }
    .people-grid section, .context-grid section { padding: 24px 0; border-right: 0; border-bottom: .5px solid var(--border); }
    .era-section { grid-template-columns: 1fr; gap: 4px; }
    .theory-grid { grid-template-columns: 1fr; }
    .theory-grid div, .theory-grid div:nth-child(odd), .theory-grid div:nth-child(even) { padding: 14px 0; border-left: 0; }
  }
</style>
