---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import AdminReportList from '../../components/admin/AdminReportList';
import { getStaffUser, isAdminRole, isMaestroRole } from '../../lib/admin';

const staff = await getStaffUser(Astro.cookies);
if (!staff) return Astro.redirect('/');
if (staff.profile.role !== 'firstchair' && !isAdminRole(staff.profile)) return Astro.redirect('/');

const isAdmin = isAdminRole(staff.profile);
const isMaestro = isMaestroRole(staff.profile);
---
<AdminLayout title="Reports" activeTab="reports" isAdmin={isAdmin} isMaestro={isMaestro} staffName={staff.profile.display_name} userRole={staff.profile.role}>
  <AdminReportList isAdmin={isAdmin} managedSections={staff.profile.managed_sections} client:load />
</AdminLayout>
