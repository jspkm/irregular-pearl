---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
---
<Layout title="Residency application" description="Application guidelines and instructions for the Irregular Pearl Artist Residency.">
  <Navbar />
  <main class="application-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><a href="/residency">Residency</a><span aria-hidden="true">/</span><span>Application</span>
    </nav>
    <article>
      <p class="kicker">Irregular Pearl Artist Residency</p>
      <h1>Application guidelines</h1>
      <div class="application-copy">
        <p>The Irregular Pearl Artist Residency supports and spotlights an exceptional emerging classical musician through a fully funded concerto performance opportunity. There is no fee to apply.</p>

        <section aria-labelledby="materials-title">
          <h2 id="materials-title">Application materials</h2>
          <p>Please submit:</p>
          <ul>
            <li>A biography and résumé</li>
            <li>Two contrasting performance recordings, as described below.</li>
            <li>Your first-choice concerto and one alternative. The final repertoire will be agreed upon with the orchestra and conductor.</li>
            <li>An artist statement of approximately 200 words responding to:
              <p class="artist-question"><em>How do you define yourself as an artist, where are you in your artistic career, and how would this residency support your next step?</em></p>
            </li>
          </ul>
        </section>

        <section aria-labelledby="recordings-title">
          <h2 id="recordings-title">Recording requirements</h2>
          <p>Submit one movement of a concerto and a contrasting work of your choice, totaling approximately 15–20 minutes. The concerto selection should be relevant to your proposed residency repertoire.</p>
          <ul>
            <li>Both selections must have been recorded within the two years preceding the application deadline.</li>
            <li>Each selection must be a continuous, unedited performance.</li>
            <li>Existing recordings and phone recordings are accepted. The performer must be clearly visible and audible.</li>
            <li>Accompaniment is not required.</li>
          </ul>
        </section>

        <section aria-labelledby="selection-title">
          <h2 id="selection-title">Selection</h2>
          <p>Applications will be evaluated on:</p>
          <ul>
            <li>Artistic individuality and musical communication.</li>
            <li>Technical readiness for the proposed concerto.</li>
            <li>Readiness to collaborate with a conductor and orchestra.</li>
            <li>The residency’s potential contribution to the applicant’s career.</li>
          </ul>
          <p>Finalists will be invited to an interview.</p>
        </section>

        <section aria-labelledby="timeline-title">
          <h2 id="timeline-title">Application timeline</h2>
          <dl class="application-timeline">
            <div><dt>Applications open:</dt><dd>To be announced</dd></div>
            <div><dt>Applications close:</dt><dd>To be announced</dd></div>
            <div><dt>Finalists notified:</dt><dd>To be announced</dd></div>
          </dl>
        </section>
        <a href="/residency">← About the residency</a>
      </div>
    </article>
  </main>
</Layout>
<style>
  .application-shell { max-width: 960px; margin: 0 auto; padding: 32px 16px 72px; }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 48px; color: var(--muted); font-size: 12px; }
  .breadcrumbs a { color: var(--muted); text-decoration: none; }
  article { max-width: 680px; }
  .kicker { margin: 0 0 12px; color: var(--accent); font-size: 11px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; }
  h1 { margin: 0 0 24px; font: 500 26px/1.25 var(--font-serif); }
  .application-copy { padding-top: 24px; border-top: .5px solid var(--border); color: var(--ink); font-size: 16px; line-height: 1.55; }
  .application-copy p { margin: 0 0 24px; }
  .application-copy section { margin: 40px 0; }
  h2 { margin: 0 0 16px; font: 500 22px/1.25 var(--font-serif); }
  .application-copy ul { list-style: disc; padding-left: 24px; margin: 0 0 24px; }
  .application-copy li { padding-left: 4px; margin-bottom: 12px; }
  .application-copy .artist-question { margin: 12px 0 0; }
  .application-timeline { margin: 0; border-top: .5px solid var(--border); }
  .application-timeline div { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 8px 24px; padding: 12px 0; border-bottom: .5px solid var(--border); }
  .application-timeline dt { font-weight: 500; }
  .application-timeline dd { margin: 0; color: var(--muted); }
  @media (max-width: 480px) { .application-timeline div { grid-template-columns: 1fr; } }
  .application-copy a { color: var(--accent); text-underline-offset: 4px; }
  a:focus-visible { outline: 1px solid var(--accent); outline-offset: 4px; }
  @media (min-width: 768px) { .application-shell { padding: 40px 32px 88px; } }
  @media (max-width: 767px) { .application-copy { font-size: 15px; } }
</style>
