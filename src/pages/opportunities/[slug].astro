---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { getCareerStages, opportunities, type Opportunity } from '../../data/opportunities';

export const prerender = true;

export function getStaticPaths() {
  return opportunities.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: Opportunity }
const { entry } = Astro.props;
const displayCareerStage = getCareerStages(entry).join(' · ');
const related = opportunities.filter((candidate) => candidate.type === entry.type && candidate.id !== entry.id).slice(0, 3);
const reviewed = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${entry.sourceReviewed}T00:00:00Z`));
const seoDescription = `${entry.name}: ${entry.summary}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOccupationalProgram',
    name: entry.name,
    description: entry.summary,
    url: Astro.url.href,
    provider: { '@type': 'Organization', name: entry.name, url: entry.officialUrl },
    occupationalCategory: 'Classical musician',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.url.origin },
      { '@type': 'ListItem', position: 2, name: 'Opportunities and Resources', item: `${Astro.url.origin}/opportunities` },
      { '@type': 'ListItem', position: 3, name: entry.name, item: Astro.url.href },
    ],
  },
];
---
<Layout title={entry.name} description={seoDescription} jsonLd={jsonLd}>
  <Navbar />

  <main class="detail-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><a href="/opportunities">Opportunities and Resources</a><span aria-hidden="true">/</span><span>{entry.name}</span>
    </nav>

    <article>
      <header class="detail-header">
        <p class="kicker">{entry.type}</p>
        <h1>{entry.name}</h1>
        {entry.shortName && <p class="short-name">Also known as {entry.shortName}</p>}
        <p class="summary">{entry.summary}</p>
        <div class="primary-meta">
          <span>{entry.location}, {entry.country}</span>
          <span>{entry.applicationRoute}</span>
          <span>{displayCareerStage}</span>
        </div>
      </header>

      {entry.currentNote && (
        <aside class="current-note">
          <p class="note-label">Current cycle note</p>
          <p>{entry.currentNote}</p>
          <p class="note-caution">Confirm current dates and requirements on the official site.</p>
        </aside>
      )}

      <div class="detail-grid">
        <div class="main-column">
          <section>
            <h2>Who it is for</h2>
            <ul>{entry.eligibility.map((item) => <li>{item}</li>)}</ul>
          </section>

          <section>
            <h2>Disciplines</h2>
            <div class="pill-list">{entry.disciplines.map((item) => <span>{item}</span>)}</div>
          </section>

          <section>
            <h2>What it provides</h2>
            <ul>{entry.support.map((item) => <li>{item}</li>)}</ul>
          </section>
        </div>

        <aside class="fact-column">
          <dl>
            <div><dt>Type</dt><dd>{entry.type}</dd></div>
            <div><dt>Location</dt><dd>{entry.location}<br />{entry.country}</dd></div>
            <div><dt>Career stage</dt><dd>{displayCareerStage}</dd></div>
            <div><dt>Entry route</dt><dd>{entry.applicationRoute}</dd></div>
            <div><dt>Schedule</dt><dd>{entry.schedule}</dd></div>
            <div><dt>Source reviewed</dt><dd>{reviewed}</dd></div>
          </dl>
          <a class="official-link" href={entry.officialUrl} target="_blank" rel="noopener noreferrer">Official program site <span aria-hidden="true">↗</span></a>
          {entry.applicationUrl && entry.applicationUrl !== entry.officialUrl && (
            <a class="application-link" href={entry.applicationUrl} target="_blank" rel="noopener noreferrer">Application information <span aria-hidden="true">↗</span></a>
          )}
        </aside>
      </div>
    </article>

    {related.length > 0 && (
      <section class="related-section">
        <h2>More {entry.type === 'Competition' ? 'competitions' : entry.type === 'Grant or award' ? 'grants and awards' : 'summer festivals'}</h2>
        <div class="related-list">
          {related.map((item) => <a href={`/opportunities/${item.id}`}><span>{item.name}</span><span aria-hidden="true">→</span></a>)}
        </div>
      </section>
    )}
  </main>
</Layout>

<style>
  .detail-shell { max-width: 1000px; margin: 0 auto; padding: 32px 16px 64px; }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; color: var(--muted); font-size: 12px; margin-bottom: 48px; }
  .breadcrumbs a { color: var(--muted); text-decoration: none; }
  .detail-header { max-width: 800px; padding-bottom: 40px; border-bottom: .5px solid var(--border-strong); }
  .kicker, .note-label { color: var(--accent); font-size: 11px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; margin: 0 0 8px; }
  h1 { font-family: var(--font-serif); font-size: 34px; font-weight: 500; line-height: 1.25; margin: 0 0 8px; }
  .short-name { color: var(--muted); font-size: 13px; margin: 0; }
  .summary { font-family: var(--font-serif); font-size: 20px; line-height: 1.6; margin: 24px 0; }
  .primary-meta { display: flex; flex-wrap: wrap; gap: 8px 20px; color: var(--muted); font-size: 12px; }
  .current-note { max-width: 800px; margin: 32px 0 0; padding: 18px 20px; border-left: 2px solid var(--accent); background: var(--accent-soft); }
  .current-note p { margin: 0; font-size: 14px; line-height: 1.55; }
  .current-note .note-label { margin-bottom: 6px; }
  .current-note .note-caution { margin-top: 6px; color: var(--muted); font-size: 12px; }
  .detail-grid { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 64px; padding: 48px 0 64px; }
  .main-column { display: grid; gap: 44px; }
  section h2 { font-size: 18px; font-weight: 500; margin: 0 0 16px; }
  ul { list-style: none; padding: 0; margin: 0; border-top: .5px solid var(--border); }
  li { position: relative; padding: 13px 0 13px 24px; border-bottom: .5px solid var(--border); font-size: 14px; }
  li::before { content: '—'; position: absolute; left: 0; color: var(--accent); }
  .pill-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .pill-list span { padding: 4px 10px; border-radius: 999px; color: var(--muted); background: var(--bg-tint); font-size: 12px; }
  .fact-column { align-self: start; border-top: .5px solid var(--border-strong); }
  dl { margin: 0; }
  dl div { padding: 13px 0; border-bottom: .5px solid var(--border); }
  dt { color: var(--tertiary); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 3px; }
  dd { margin: 0; font-size: 13px; line-height: 1.45; }
  .official-link, .application-link { display: flex; justify-content: space-between; gap: 12px; min-height: 44px; align-items: center; padding: 10px 12px; margin-top: 12px; border-radius: 8px; font-size: 13px; text-decoration: none; }
  .official-link { color: var(--bg); background: var(--ink); }
  .application-link { color: var(--ink); border: .5px solid var(--border-strong); }
  .related-section { padding-top: 40px; border-top: .5px solid var(--border-strong); }
  .related-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: .5px solid var(--border); }
  .related-list a { display: flex; justify-content: space-between; gap: 16px; padding: 16px 16px 16px 0; margin-right: 24px; border-bottom: .5px solid var(--border); color: var(--ink); text-decoration: none; font-size: 14px; }
  .related-list a:hover { color: var(--accent); }
  @media (min-width: 768px) { .detail-shell { padding: 40px 32px 80px; } }
  @media (max-width: 760px) {
    .breadcrumbs { margin-bottom: 32px; }
    .detail-grid { grid-template-columns: 1fr; gap: 40px; }
    .fact-column { order: -1; }
    .related-list { grid-template-columns: 1fr; }
    .related-list a { margin-right: 0; }
  }
</style>
