---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import AdminUserList from '../../components/admin/AdminUserList';
import { getStaffUser, isAdminRole, isMaestroRole } from '../../lib/admin';

const staff = await getStaffUser(Astro.cookies);
if (!staff) return Astro.redirect('/');
if (!isAdminRole(staff.profile)) return Astro.redirect('/admin');

const isMaestro = isMaestroRole(staff.profile);
---
<AdminLayout title="User Management" activeTab="users" isAdmin={true} isMaestro={isMaestro} staffName={staff.profile.display_name} userRole={staff.profile.role}>
  <AdminUserList client:load />
</AdminLayout>
