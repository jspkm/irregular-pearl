---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

const seoDescription = `A non-profit classical music knowledge platform for classical musicians. Piece pages with structural landmarks, signed performer's notes, and edition comparison at the measure level.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Irregular Pearl',
  description: seoDescription,
  url: Astro.url.href,
  mainEntity: {
    '@type': 'Organization',
    name: 'Irregular Pearl',
    url: Astro.url.origin,
    description: seoDescription,
    nonprofitStatus: 'NonprofitType',
    foundingDate: '2026',
    knowsAbout: ['Classical Music', 'Sheet Music Editions', 'Music Repertoire', 'Music Education', 'Performance Practice'],
  },
};
---
<Layout title="About" description={seoDescription} jsonLd={jsonLd}>
  <Navbar />

  <main class="max-w-2xl mx-auto px-4 md:px-6 py-12 md:py-16">
    <h1 class="font-display text-3xl md:text-4xl italic mb-6">About Irregular Pearl</h1>

    <div class="space-y-6 text-sm md:text-base text-[#57534E] leading-relaxed">
      <p>
        Irregular Pearl is a non-profit classical music knowledge platform for classical musicians — performers, teachers, and students preparing real repertoire, piece by piece.
      </p>

      <p>
        Every piece gets a living page: structural landmarks grouped by movement, editions compared at the measure level, and performer's notes from people who have played the work. Paired with a personal library that tracks what you are preparing, what you have performed, and the reflections you jot between takes.
      </p>

      <p>
        The name comes from the etymology of <em>baroque</em> — from the Portuguese <em>barroco</em>, meaning an irregularly shaped pearl. Like the era that gave us Bach, Vivaldi, and Handel, we believe the most interesting things are rarely perfectly round.
      </p>

      <h2 class="font-display text-xl md:text-2xl italic text-ink pt-4">What we do</h2>

      <ul class="space-y-3 list-none pl-0">
        <li class="flex gap-3">
          <span class="text-[#B45309] font-semibold flex-shrink-0">Piece pages.</span>
          <span>Structural landmarks grouped by movement, with flags for the technical challenges in each passage. Signed performer's notes and interpretive schools alongside. Every editorial claim carries a human name.</span>
        </li>
        <li class="flex gap-3">
          <span class="text-[#B45309] font-semibold flex-shrink-0">Edition comparison.</span>
          <span>The same passage side by side across editions — bowings, fingerings, articulation, sources — with signed editorial observations. Makes the edition decision concrete instead of guesswork.</span>
        </li>
        <li class="flex gap-3">
          <span class="text-[#B45309] font-semibold flex-shrink-0">Personal library.</span>
          <span>Pieces currently preparing, upcoming performances, pieces performed, and private reflections attached to specific passages.</span>
        </li>
      </ul>

      <h2 class="font-display text-xl md:text-2xl italic text-ink pt-4">Plurality of voices</h2>

      <p>
        When two respected musicians hold incompatible views on how a piece should be played, Irregular Pearl shows both, signed, with neither presented as canonical. The site is editorial before it is technical. Interpretive judgment carries a human name — we do not publish anonymous opinions or AI-generated content under false bylines.
      </p>

      <h2 class="font-display text-xl md:text-2xl italic text-ink pt-4">Open and free</h2>

      <p>
        Irregular Pearl is a non-profit. All piece data, edition information, and editorial writing are free to access. We describe editions, we do not reproduce them. We reference recordings, we do not host them.
      </p>
    </div>
  </main>
</Layout>
