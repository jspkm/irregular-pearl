---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import AboutContent from '../components/AboutContent.astro';

const seoDescription = `A non-profit classical music knowledge platform for classical musicians. Piece pages with structural landmarks, signed performer's notes, and edition comparison at the measure level.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Irregular Pearl',
  description: seoDescription,
  url: Astro.url.href,
  mainEntity: {
    '@type': 'Organization',
    name: 'Irregular Pearl',
    url: Astro.url.origin,
    description: seoDescription,
    nonprofitStatus: 'NonprofitType',
    foundingDate: '2026',
    knowsAbout: ['Classical Music', 'Sheet Music Editions', 'Music Repertoire', 'Music Education', 'Performance Practice'],
  },
};
---
<Layout title="About" description={seoDescription} jsonLd={jsonLd}>
  <Navbar />

  <main class="max-w-2xl mx-auto px-4 md:px-6 py-12 md:py-16">
    <h1 class="text-3xl md:text-4xl font-medium tracking-tight mb-6">About Irregular Pearl</h1>

    <AboutContent />
  </main>
</Layout>
