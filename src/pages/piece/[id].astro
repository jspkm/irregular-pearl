---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PiecePageLayout from '../../components/PiecePageLayout.astro';
import { getPieceFull, isStub } from '../../lib/pieces';
import { resolvePieceRedirect } from '../../lib/pieceRedirects';
import { supabase, hasSupabase } from '../../lib/supabase';

const { id } = Astro.params;
const slug = id || '';
const piece = await getPieceFull(slug);

// Identity-immutability fallback: if the slug isn't a current piece, check
// piece_redirects. Old slugs 301 forever to their canonical target. This is
// the only supported path for slug corrections — pieces.id is never updated
// in place.
if (!piece) {
  const toSlug = await resolvePieceRedirect(slug);
  if (toSlug) {
    return Astro.redirect(`/piece/${toSlug}`, 301);
  }
  return Astro.redirect('/');
}

// One piece page, one layout. Mode decides which sections render.
// Awaiting-first-contribution mode (no signed content yet, and the viewer
// hasn't clicked the primary CTA) renders identity (title, byline, pills,
// description) + reference layer (movements, editions, recordings,
// pedagogical arc, external references) + the invite block; signed-content
// sections (performer's notes, signed piece descriptions, signed
// difficulty, interpretive schools, structural landmarks) stay hidden.
// ?expand=1 flips to the full writeable mode — that's where "Start the
// first contribution" routes.
// ?compose=<request_id> also forces 'full' so the sender can draft into
// each section of a piece that's still a stub.
// A piece with un-cleared sent contribution_requests also renders 'full',
// because it's under active editorial conversation — the recipient needs
// the signed-content sections to render so proposed drafts display inline.
// Pieces that already have signed content always render 'full' regardless.
const expand = Astro.url.searchParams.get('expand') === '1';
const composing = Astro.url.searchParams.has('compose');
const stub = isStub(piece);

let hasActiveRequests = false;
if (stub && !expand && !composing && hasSupabase) {
  // Call the security-definer RPC: SSR's anon-session client can't SELECT
  // contribution_requests directly (RLS scopes reads to sender/recipient/staff),
  // so we go through a function that exposes only a boolean.
  const { data } = await supabase.rpc('piece_has_active_contribution_requests', {
    p_piece_id: piece.id,
  });
  hasActiveRequests = data === true;
}

const mode: 'awaiting-first-contribution' | 'full' =
  !expand && !composing && !hasActiveRequests && stub ? 'awaiting-first-contribution' : 'full';
const breadcrumb = [piece.instruments[0] || 'Music', piece.composer_name];
const seoDescription = stub
  ? `${piece.title}${piece.catalog_number ? ` (${piece.catalog_number})` : ''} by ${piece.composer_name} — help build this page on Irregular Pearl.`
  : `${piece.title}${piece.catalog_number ? ` (${piece.catalog_number})` : ''} by ${piece.composer_name} — compare ${piece.editions.length} editions, listen to recordings, and discuss with musicians. ${piece.description.slice(0, 120)}`;

const youtubeLinks = piece.external_links.filter(l => l.type === 'youtube');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicComposition',
  name: piece.title,
  alternateName: piece.catalog_number || undefined,
  composer: {
    '@type': 'Person',
    name: piece.composer_name,
  },
  musicCompositionForm: piece.form,
  genre: piece.era,
  description: piece.description,
  instrument: piece.instruments,
  timeRequired: piece.duration_minutes ? `PT${piece.duration_minutes}M` : undefined,
  url: Astro.url.href,
  // Google-friendly: link to recordings as audio objects
  recordedAs: youtubeLinks.map(l => ({
    '@type': 'MusicRecording',
    name: l.label,
    url: l.url,
  })),
  // Speakable for Google Assistant
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.description', '.edition-name'],
  },
  isPartOf: {
    '@type': 'WebSite',
    name: 'Irregular Pearl',
    url: Astro.url.origin,
  },
  // FAQPage-style: helps Google show piece info in featured snippets
  mainEntity: {
    '@type': 'Question',
    name: `What are the best editions of ${piece.title} by ${piece.composer_name}?`,
    acceptedAnswer: {
      '@type': 'Answer',
      text: piece.editions.map(e => `${e.publisher} (${e.editor}${e.year ? `, ${e.year}` : ''}): ${e.description}`).join(' '),
    },
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.url.origin },
    { '@type': 'ListItem', position: 2, name: piece.instruments[0] || 'Music', item: `${Astro.url.origin}/instrument/${encodeURIComponent((piece.instruments[0] || 'music').toLowerCase())}` },
    { '@type': 'ListItem', position: 3, name: piece.title },
  ],
};
---
<Layout
  title={piece.title}
  description={seoDescription}
  ogType="music.song"
  jsonLd={[jsonLd, breadcrumbLd]}
  noindex={stub}
>
  <Navbar />

  {/* Breadcrumbs are rendered inside PiecePageLayout. One layout, one page. */}
  <PiecePageLayout piece={piece} mode={mode} />
</Layout>
