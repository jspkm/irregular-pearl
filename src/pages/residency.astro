---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

const description = 'The Irregular Pearl Resident Artist Program supports and spotlights exceptional emerging classical musicians with a guest concerto soloist opportunity.';
---
<Layout title="Resident Artist Program" description={description}>
  <Navbar />
  <main class="residency-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><span>Residency</span>
    </nav>
    <article aria-labelledby="residency-title">
      <header>
        <p class="kicker">Supporting emerging artists</p>
        <h1 id="residency-title">Resident Artist Program</h1>
      </header>
      <div class="residency-copy">
        <p>The Irregular Pearl Resident Artist Program supports and spotlights exceptional emerging classical musicians. Each year, one artist is invited to be a guest concerto soloist with an established orchestra alongside professional documentation, promotion, and artistic connections.</p>
        <p>Supported by Irregular Pearl’s donors and chosen by the board and select esteemed musician judges, the program helps artists build on years of preparation, reach new audiences, and strengthen the next stage of their careers.</p>
        <p>Applying and participating are free.</p>
        <p><a class="application-link" href="/residency/application">Application guidelines and instructions <span aria-hidden="true">→</span></a></p>
      </div>
    </article>
  </main>
</Layout>

<style>
  .residency-shell { max-width: 960px; margin: 0 auto; padding: 32px 16px 72px; }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 48px; color: var(--muted); font-size: 12px; }
  .breadcrumbs a { color: var(--muted); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--ink); }
  article { max-width: 680px; }
  header { margin-bottom: 24px; }
  .kicker { margin: 0 0 12px; color: var(--accent); font-size: 11px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; }
  h1 { margin: 0; font-family: var(--font-serif); font-size: 26px; font-weight: 500; line-height: 1.25; }
  .residency-copy { border-top: .5px solid var(--border); padding-top: 24px; font-size: 16px; line-height: 1.55; color: var(--ink); }
  .residency-copy p { margin: 0 0 24px; }
  .residency-copy p:last-child { margin-bottom: 0; }
  .application-link { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
  .application-link:hover { color: var(--accent-hover); }
  .application-link:focus-visible { outline: 1px solid var(--accent); outline-offset: 4px; }
  @media (min-width: 768px) { .residency-shell { padding: 40px 32px 88px; } }
  @media (max-width: 767px) { .residency-copy { font-size: 15px; } }
</style>
