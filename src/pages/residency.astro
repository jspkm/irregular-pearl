---
import Layout from '../layouts/Layout.astro';
import SiteMasthead from '../components/SiteMasthead.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const description = 'The Irregular Pearl Resident Artist Program supports and spotlights exceptional emerging classical musicians. Applying and participating are free. Read about the program and its application guidelines.';
---
<Layout title="Resident Artist Program" description={description}>
  <SiteMasthead />
  <main class="residency-shell">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Residency' }]} />
    <article aria-labelledby="residency-title">
      <header>
        <h1 id="residency-title">Resident Artist Program</h1>
      </header>
      <div class="residency-copy">
        <p>The Irregular Pearl Resident Artist Program supports and spotlights exceptional emerging classical musicians.</p>
        <p>Supported by Irregular Pearl’s donors and chosen by the board and select esteemed musician judges, the program helps artists build on years of preparation, reach new audiences, and strengthen the next stage of their careers.</p>
        <p>Applying and participating are free.</p>
      </div>

      <section id="application" class="application" aria-labelledby="application-title">
        <h2 id="application-title">Application guidelines</h2>

        <section aria-labelledby="materials-title">
          <h3 id="materials-title">Application materials</h3>
          <p>Please submit:</p>
          <ul>
            <li>A biography and résumé</li>
            <li>Two contrasting performance recordings, as described below.</li>
            <li>Your first-choice concerto and one alternative. The final repertoire will be agreed upon with the orchestra and conductor.</li>
            <li>An artist statement of approximately 200 words responding to:
              <p class="artist-question"><em>How do you define yourself as an artist, where are you in your artistic career, and how would this residency support your next step?</em></p>
            </li>
          </ul>
        </section>

        <section aria-labelledby="recordings-title">
          <h3 id="recordings-title">Recording requirements</h3>
          <p>Submit one movement of a concerto and a contrasting work of your choice, totaling approximately 15–20 minutes. The concerto selection should be relevant to your proposed residency repertoire.</p>
          <ul>
            <li>Both selections must have been recorded within the two years preceding the application deadline.</li>
            <li>Each selection must be a continuous, unedited performance.</li>
            <li>Existing recordings and phone recordings are accepted. The performer must be clearly visible and audible.</li>
            <li>Accompaniment is not required.</li>
          </ul>
        </section>

        <section aria-labelledby="selection-title">
          <h3 id="selection-title">Selection</h3>
          <p>Applications will be evaluated on:</p>
          <ul>
            <li>Artistic individuality and musical communication.</li>
            <li>Technical readiness for the proposed concerto.</li>
            <li>Readiness to collaborate with a conductor and orchestra.</li>
            <li>The residency’s potential contribution to the applicant’s career.</li>
          </ul>
          <p>Finalists will be invited to an interview.</p>
        </section>

        <section aria-labelledby="timeline-title">
          <h3 id="timeline-title">Application timeline</h3>
          <dl class="application-timeline">
            <div><dt>Applications open:</dt><dd>To be announced</dd></div>
            <div><dt>Applications close:</dt><dd>To be announced</dd></div>
            <div><dt>Finalists notified:</dt><dd>To be announced</dd></div>
          </dl>
        </section>
      </section>
    </article>
  </main>
</Layout>

<style>
  .residency-shell { max-width: 960px; margin: 0 auto; padding: 32px 16px 72px; }
  article { max-width: 680px; }
  header { margin-bottom: 24px; }
  h1 { margin: 0; font-family: var(--font-serif); font-size: 26px; font-weight: 500; line-height: 1.25; }
  .residency-copy, .application { font-size: 16px; line-height: 1.55; color: var(--ink); }
  .residency-copy { border-top: .5px solid var(--border); padding-top: 24px; }
  .residency-copy p, .application p { margin: 0 0 24px; }
  .application { margin-top: 56px; padding-top: 32px; border-top: .5px solid var(--border); scroll-margin-top: 24px; }
  h2 { margin: 0 0 8px; font: 500 22px/1.25 var(--font-serif); }
  .application section { margin: 32px 0 0; }
  h3 { margin: 0 0 12px; font-size: 16px; font-weight: 600; line-height: 1.4; }
  .application ul { list-style: disc; padding-left: 24px; margin: 0 0 24px; }
  .application li { padding-left: 4px; margin-bottom: 12px; }
  .application .artist-question { margin: 12px 0 0; }
  .application-timeline { margin: 0; border-top: .5px solid var(--border); }
  .application-timeline div { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 8px 24px; padding: 12px 0; border-bottom: .5px solid var(--border); }
  .application-timeline dt { font-weight: 500; }
  .application-timeline dd { margin: 0; color: var(--muted); }
  a:focus-visible { outline: 1px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 480px) { .application-timeline div { grid-template-columns: 1fr; } }
  @media (min-width: 768px) { .residency-shell { padding: 40px 32px 88px; } }
  @media (max-width: 767px) { .residency-copy, .application { font-size: 15px; } }
</style>
