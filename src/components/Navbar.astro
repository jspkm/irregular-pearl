---
import AuthButton from './AuthButton';
---
<nav class="flex items-center gap-4 md:gap-6 px-4 md:px-6 py-3 border-b border-border bg-surface sticky top-0 z-50">
  <a href="/" class="no-underline shrink-0 text-ink font-medium tracking-tight text-base md:text-lg flex items-baseline gap-2">
    <span>IrregularPearl</span>
    <span class="text-[11px] font-normal text-muted tracking-normal">beta</span>
  </a>

  <div class="flex-1 max-w-md">
    <form action="/" method="get">
      <input
        type="search"
        name="q"
        placeholder="Search pieces, composers..."
        class="w-full px-3 py-2 border border-border rounded-lg text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent-light font-body"
      />
    </form>
  </div>

  <div class="flex items-center gap-4 md:gap-5 text-sm text-ink">
    <a href="/browse/era" class="no-underline text-ink hover:text-accent transition-colors hidden sm:inline">Browse</a>
    <a href="/about" class="no-underline text-ink hover:text-accent transition-colors hidden sm:inline">About</a>
    <AuthButton client:load />
  </div>
</nav>
