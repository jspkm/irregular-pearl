---
// Piece page layout — ported from the Claude design kit, adapted for the
// curated catalog and the current schema. Uses the kit-namespace CSS
// variables (see src/styles/global.css :root) via src/styles/piece-page.css.
//
// All Tier 1 sections are wired to live data:
//   - Breadcrumbs, piece header, metadata pills
//   - Signed piece descriptions (stack: user-authored + unsigned seed)
//   - Signed four-axis difficulty (stack: user ratings + seed from difficulty-axes.ts)
//   - Performer's notes (plural signed, ordered by net_score)
//   - Interpretive schools (plural signed)
//   - External references (IMSLP / Wikipedia, wiki-edit)
//   - Change log link (per-piece chronological feed)

import '../styles/piece-page.css';
import type { PieceFull } from '../lib/pieces';
import { difficultyAxes } from '../data/difficulty-axes';
import { getPublishedPerformersNotes } from '../lib/performersNotes';
import { getPublishedInterpretiveSchools } from '../lib/interpretiveSchools';
import { getPublishedPieceDescriptions } from '../lib/pieceDescriptions';
import { fetchMovementsForPiece } from '../lib/movements';
import { fetchOrderedSubjects, fetchSeedDescriptionVoteId } from '../lib/votes';
import { getPublishedPieceDifficultyRatings, fetchSeedDifficultyVoteId } from '../lib/pieceDifficulty';
import PerformersNotes from './PerformersNotes';
import InterpretiveSchools from './InterpretiveSchools';
import SignedPieceDescription from './SignedPieceDescription';
import SignedPieceDifficulty from './SignedPieceDifficulty';
import MovementsList from './MovementsList';
import ExternalRefsList from './ExternalRefsList';
import { fetchExternalLinksForPiece, REFERENCE_TYPES } from '../lib/externalLinks';
import { getPiecePills, pillsFromPieceFields } from '../lib/piecePills';
import RecipientRibbon from './RecipientRibbon';
import PiecePills from './PiecePills';
import PieceViewLogger from './PieceViewLogger';
import DraftingModeBanner from './DraftingModeBanner';
import PerformanceCalendar from './PerformanceCalendar';
import { getPieceCompletionYear } from '../data/pieceCompletionYears';
import { getSummaryComments } from '../lib/summaryComments';
import SummaryComments from './SummaryComments';

interface Props {
  piece: PieceFull;
  embedded?: boolean;
  /**
   * 'awaiting-first-contribution' renders identity (title, catalog,
   * byline, pills, description paragraph) + reference layer (editions,
   * external links, movements, recordings, pedagogical arc) + the
   * invite block. Signed-content sections (performer's notes,
   * signed piece descriptions, signed difficulty, interpretive schools,
   * structural landmarks) are hidden.
   *
   * 'full' renders the complete piece page including all signed-content
   * sections.
   */
  mode?: 'awaiting-first-contribution' | 'full';
}

const { piece, mode = 'full', embedded = false } = Astro.props;
const PageContainer = embedded ? 'section' : 'main';
const Title = embedded ? 'h2' : 'h1';
const isAwaiting = mode === 'awaiting-first-contribution';
// Drafting mode: a staff member opens a piece with ?compose=<request_id> to
// compose drafts on an outbox request before sending. The banner + composer
// are client-mounted (they make their own auth + ownership checks); we only
// use Astro.url here to know whether to reserve space on the page.
const composeRequestId = Astro.url.searchParams.get('compose') ?? null;
const composing = composeRequestId !== null;
const [performersNotesRaw, interpretiveSchoolsRaw, signedDescriptionsRaw, dbMovements, dbLinks, seedDescriptionVoteId, difficultyRatingsRaw, seedDifficultyVoteId, dbPills, summaryComments] = await Promise.all([
  getPublishedPerformersNotes(piece.id),
  getPublishedInterpretiveSchools(piece.id),
  getPublishedPieceDescriptions(piece.id),
  fetchMovementsForPiece(piece.id),
  fetchExternalLinksForPiece(piece.id),
  fetchSeedDescriptionVoteId(piece.id),
  getPublishedPieceDifficultyRatings(piece.id),
  fetchSeedDifficultyVoteId(piece.id),
  getPiecePills(piece.id),
  getSummaryComments(piece.id),
]);
// If the DB has no pills (e.g. preview build with no Supabase, or a piece
// the seed pipeline missed), fall back to constructing read-only pills
// from the piece's scalar fields.
const initialPills = (dbPills.length > 0 ? dbPills : pillsFromPieceFields(piece))
  .filter((pill) => pill.category !== 'difficulty');
const dbReferenceLinks = dbLinks.filter((l) => (REFERENCE_TYPES as readonly string[]).includes(l.type));

// Reorder signed content by vote_tallies.net_score DESC (tie-break by id)
// via the fetch_ordered_subjects RPC. Never exposes raw counts.
const [orderedNoteIds, orderedSchoolIds, orderedDescriptionIds, orderedDifficultyIds] = await Promise.all([
  fetchOrderedSubjects('performers_notes', performersNotesRaw.map((n) => n.noteId)),
  fetchOrderedSubjects('interpretive_schools', interpretiveSchoolsRaw.map((s) => s.schoolId)),
  fetchOrderedSubjects('piece_descriptions', signedDescriptionsRaw.map((d) => d.descriptionId)),
  fetchOrderedSubjects('piece_difficulty_ratings', difficultyRatingsRaw.map((r) => r.ratingId)),
]);
const performersNotes = orderedNoteIds
  .map((id) => performersNotesRaw.find((n) => n.noteId === id))
  .filter((n): n is NonNullable<typeof n> => n != null);
const interpretiveSchools = orderedSchoolIds
  .map((id) => interpretiveSchoolsRaw.find((s) => s.schoolId === id))
  .filter((s): s is NonNullable<typeof s> => s != null);
const signedDescriptions = orderedDescriptionIds
  .map((id) => signedDescriptionsRaw.find((d) => d.descriptionId === id))
  .filter((d): d is NonNullable<typeof d> => d != null);
const difficultyRatings = orderedDifficultyIds
  .map((id) => difficultyRatingsRaw.find((r) => r.ratingId === id))
  .filter((r): r is NonNullable<typeof r> => r != null);
const seedMovements = (piece.movements ?? []).map((m) => ({
  name: m.name,
  key: m.key,
  meter: m.meter,
}));
const hasSignedDescription = signedDescriptions.length > 0;
const axes = difficultyAxes[piece.id];

const composedHint = piece.era && piece.form ? `${piece.era} · ${piece.form}` : (piece.era || piece.form || '');
const completionYear = getPieceCompletionYear(piece.id);

---

{composing && <DraftingModeBanner client:load pieceId={piece.id} />}

<PageContainer class:list={["page", { "embedded-piece": embedded }]} data-compose-mode={composing ? '1' : undefined}>
  {!embedded && <PieceViewLogger client:load pieceId={piece.id} />}

  <div class="crumbs" hidden={embedded}>
    <a href="/pieces">Pieces</a><span class="sep">/</span>
    <a href={`/composer/${encodeURIComponent(piece.composer_name)}`}>{piece.composer_name}</a><span class="sep">/</span>
    <span>{piece.title}</span>
  </div>

  <div class="piece-header-row">
    <div class="piece-header-main">
      <Title class="piece">
        {piece.title}
        {completionYear && <span class="completion-year">{completionYear}</span>}
        {piece.catalog_number && <span class="cat">{piece.catalog_number}</span>}
      </Title>
      <p class="byline">
        by <a href={`/composer/${encodeURIComponent(piece.composer_name)}`}>{piece.composer_name}</a>
      </p>

      <PiecePills client:load pieceId={piece.id} initialPills={initialPills} readOnly={isAwaiting} />
    </div>

    <div class="piece-header-aside">
      <RecipientRibbon client:load pieceId={piece.id} />
    </div>
  </div>

  {/* Identity-layer description. The encyclopedia paragraph is part
      of what the piece *is* — like the title and catalog number — not
      content awaiting a signature. Renders only in awaiting mode here
      as plain identity prose; in 'full' mode the same text appears as
      the bottom-of-stack "Seed data" card inside SignedPieceDescription
      with vote thumbs (a different role). */}
  {isAwaiting && piece.description && piece.description.trim().length > 0 && (
    <section class="block identity-description-with-comments" id="identity-description">
      <div class="piece-intro"><SummaryComments client:load pieceId={piece.id} initialComments={summaryComments} summaryText={piece.description.trim()} /></div>
    </section>
  )}

  {/* ===== Signed-content sections (gated to full mode) ===== */}
  {!isAwaiting && (
    <>
      {/* Signed descriptions stack (includes the unsigned pieces.description as
          a synthetic "Seed data" card at the bottom of the stack; user-authored
          entries sort above by vote score). */}
      <section class="block" id="signed-description">
        <SignedPieceDescription client:load pieceId={piece.id} initialDescriptions={signedDescriptions} seedDescription={piece.description} seedDescriptionVoteId={seedDescriptionVoteId} initialSummaryComments={summaryComments} />
      </section>

      <section class="block" id="difficulty">
        <div class="kicker">Difficulty</div>
        <SignedPieceDifficulty
          client:load
          pieceId={piece.id}
          initialRatings={difficultyRatings}
          seedAxes={axes ?? null}
          seedDifficultyVoteId={seedDifficultyVoteId}
        />
      </section>

      <section class="block" id="performers-notes">
        <div class="kicker">Performer's notes</div>
        <PerformersNotes client:load pieceId={piece.id} initialNotes={performersNotes} />
      </section>

      <section class="block" id="interpretive-schools">
        <div class="kicker">Interpretive schools</div>
        <InterpretiveSchools client:load pieceId={piece.id} initialSchools={interpretiveSchools} />
      </section>
    </>
  )}

  {/* ===== Reference layer (renders in both modes) ===== */}
  <section class="block">
    <div class="kicker">Movements</div>
    <MovementsList
      client:load
      pieceId={piece.id}
      initialMovements={dbMovements}
      seedMovements={seedMovements}
      awaitingMode={isAwaiting}
      showAddControl={true}
      showLandmarks={false}
    />
  </section>

  <section class="block" id="performance-calendar">
    <PerformanceCalendar client:load pieceId={piece.id} pieceTitle={piece.title} />
  </section>


  <section class="block">
    <div class="kicker">External references</div>
    <ExternalRefsList client:load pieceId={piece.id} initialLinks={dbReferenceLinks} />
  </section>

  <p class="change-log-link">
    <a href={`/piece/${piece.id}/change-log`}>Change log</a>
  </p>

</PageContainer>

<style>
  .completion-year {
    margin-left: 12px;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: .42em;
    font-style: normal;
    font-weight: 400;
    white-space: nowrap;
    vertical-align: middle;
  }
  /* Empty state copy — state, not philosophy */
  .empty-state {
    font-size: 14px;
    color: var(--tertiary);
    font-style: italic;
    margin: 0;
  }

  /* Piece intro — unsigned pieces.description as the primary paragraph when
     no signed editorial description exists on the piece yet. */
  .piece-intro {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: var(--lh-serif-prose);
    color: var(--ink);
    max-width: 640px;
    margin: 0 0 48px;
  }

  .identity-description-with-comments {
    position: relative;
    max-width: 690px;
    padding: 20px 0;
  }

  /* 7A: metadata-strip treatment. When a signed piece description exists,
     the unsigned reference blurb demotes to this smaller italic strip so
     the signed essay carries the editorial weight. */
  .piece-meta-strip {
    font-family: var(--font-sans);
    font-style: italic;
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 640px;
    margin: 0 0 32px;
  }

  /* Destination links (Option D): serif accent with trailing glyph. A
     fading 0.5px underline on hover is the only motion. Used for the
     Change log section-ending link and the External references list. */
  .change-log-link {
    margin: 40px 0 0;
    font-family: var(--font-serif);
    font-size: 14px;
  }
  .change-log-link a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 0.5px solid transparent;
    padding-bottom: 1px;
    transition: border-color 160ms ease;
  }
  .change-log-link a::after {
    content: ' →';
    color: var(--accent);
  }
  .change-log-link a:hover,
  .change-log-link a:focus-visible {
    border-bottom-color: var(--accent);
  }

  /* (External-references styling lives in src/styles/piece-page.css so
     the React island's elements match the selectors — scoped Astro
     styles here would be hashed to data-astro-cid-* attributes that the
     island's DOM doesn't carry.) */

  /* Edition card list */
  .editions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ed-body {
    flex: 1;
  }
  /* When the edition card is rendered as a link, strip anchor chrome and inherit colour
     so the kit's .ed card styling stays intact. */
  a.ed {
    color: inherit;
    text-decoration: none;
  }
  a.ed:hover .type-chip {
    background: var(--accent);
    color: var(--bg);
  }

  /* Responsive */
  @media (max-width: 760px) {
    .page {
      padding: 32px 20px 64px;
    }
  }
</style>

<style>
  .embedded-piece { padding: 0 0 48px; }
  .crumbs[hidden] { display: none; }
</style>
