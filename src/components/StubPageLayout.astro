---
// Pre-piece page: materialized piece with no published signed content yet.
// Uses the same piece-page.css tokens as PiecePageLayout so visual identity
// is continuous — the pre-piece page is a stripped-down materialized piece
// page, not a different product.
//
// Section ordering reflects the design doc:
//   1. Crumbs (Pieces / Composer / Title) — identical to active page
//   2. H1 title + catalog + byline — identical
//   3. Metadata pills (era + form) — identical
//   4. NOT YET CURATED kicker + invitation + CTAs — the pre-piece block
//   5. (Optional) About this piece — inline description author (staff/any
//      logged-in user), will later route through the piece-description
//      signed-content pipeline
//   6. (Optional) Movements — inline wiki-edit

import '../styles/piece-page.css';
import type { PieceFull } from '../lib/pieces';
import StubContributionForms from './StubContributionForms';
---

<main class="page">
  <div class="crumbs">
    <a href="/">Pieces</a><span class="sep">/</span>
    <a href={`/composer/${encodeURIComponent(Astro.props.piece.composer_name)}`}>{Astro.props.piece.composer_name}</a><span class="sep">/</span>
    <span>{Astro.props.piece.title}</span>
  </div>

  <div class="kicker">Not yet curated</div>

  <h1 class="piece">
    {Astro.props.piece.title}
    {Astro.props.piece.catalog_number && <span class="cat">{Astro.props.piece.catalog_number}</span>}
  </h1>
  <p class="byline">
    by <a href={`/composer/${encodeURIComponent(Astro.props.piece.composer_name)}`}>{Astro.props.piece.composer_name}</a>
  </p>

  <div class="pills">
    {Astro.props.piece.era && <span class="pill">{Astro.props.piece.era}</span>}
    {Astro.props.piece.form && <span class="pill">{Astro.props.piece.form}</span>}
    {Astro.props.piece.instruments.slice(0, 3).map((i) => <span class="pill">{i}</span>)}
  </div>

  <section class="block" id="invitation">
    <p class="invitation-lede">
      This piece has no signed contributions yet.
    </p>
    <p class="invitation-prose">
      Write the first performer's note, a practice note on a specific passage,
      or an interpretive school you'd defend in front of colleagues.
    </p>
  </section>

  <section class="block" id="about">
    <div class="kicker">About this piece</div>
    <StubContributionForms
      pieceId={Astro.props.piece.id}
      existingDescription={Astro.props.piece.description}
      existingMovements={Astro.props.piece.movements}
      client:load
    />
  </section>
</main>

<style>
  .invitation-lede {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.35;
    color: var(--ink);
    margin: 0 0 12px;
    font-weight: 500;
  }
  .invitation-prose {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.6;
    max-width: 640px;
    margin: 0;
  }
</style>
