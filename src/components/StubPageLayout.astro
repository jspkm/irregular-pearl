---
// Pre-piece page: materialized piece with no published signed content yet.
// Uses the same piece-page.css tokens as PiecePageLayout so visual identity
// is continuous — the pre-piece page is a stripped-down materialized piece
// page, not a different product.
//
// Design doc spec (minimalist blank slot):
//   1. Crumbs (Pieces / Composer / Title) — identical to active page
//   2. H1 title + catalog + byline — identical to active page
//   3. Pills row (era / form / instruments) — identical
//   4. Invitation block: "This piece has no signed contributions yet" +
//      editorial prose framing what kinds of contributions fit. The lede
//      itself names the state; no separate kicker eyebrow is needed.
//   5. CTAs: primary "Start the first contribution" + ghost-link
//      "Know someone who should? Request a contribution."
//
// The page is deliberately short. No inline description form, no movements
// editor, no sidebar. When a contributor arrives, this page is a promise:
// the piece is real, the page is real, the first signed voice is the thing
// that's missing. That's what the CTAs are for.

import '../styles/piece-page.css';
import type { PieceFull } from '../lib/pieces';
import { getPiecePills, pillsFromPieceFields } from '../lib/piecePills';
import PiecePills from './PiecePills';
import RequestContributionDialog from './RequestContributionDialog';
import RecipientRibbon from './RecipientRibbon';
import StartContributionButton from './StartContributionButton';

interface Props {
  piece: PieceFull;
}

const { piece } = Astro.props;

// Match PiecePageLayout: the canonical pill row comes from piece_pills
// (source of truth, lowercased on seed). Fall back to scalar piece fields
// only when the DB has nothing (no Supabase, or a piece the seed pipeline
// missed). Keeps the pill display consistent between pre-piece and active
// pages.
const dbPills = await getPiecePills(piece.id);
const initialPills = dbPills.length > 0 ? dbPills : pillsFromPieceFields(piece);
---

<main class="page">
  <div class="crumbs">
    <a href="/">Pieces</a><span class="sep">/</span>
    <a href={`/composer/${encodeURIComponent(piece.composer_name)}`}>{piece.composer_name}</a><span class="sep">/</span>
    <span>{piece.title}</span>
  </div>

  <h1 class="piece">
    {piece.title}
    {piece.catalog_number && <span class="cat">{piece.catalog_number}</span>}
  </h1>
  <p class="byline">
    by <a href={`/composer/${encodeURIComponent(piece.composer_name)}`}>{piece.composer_name}</a>
  </p>

  <PiecePills client:load pieceId={piece.id} initialPills={initialPills} readOnly />

  <RecipientRibbon client:load pieceId={piece.id} />

  <section class="block pp-invite" id="invitation">
    <p class="pp-invite-lede">
      This piece has no signed contributions yet.
    </p>
    <p class="pp-invite-prose">
      Write the first performer's note, a practice note on a specific passage,
      or an interpretive school you'd defend in front of colleagues.
    </p>
    <div class="pp-cta-row">
      <StartContributionButton client:load pieceId={piece.id} />
      <RequestContributionDialog
        client:load
        pieceId={piece.id}
        pieceTitle={piece.title}
        composerName={piece.composer_name}
        triggerLabel="Know someone who should? Request a contribution."
        triggerClassName="pp-cta-ghost"
      />
    </div>
  </section>
</main>

<!-- Styles for the pre-piece invitation block + CTAs live in
     src/styles/piece-page.css (.pp-* namespace). React-island children
     (the RequestContributionDialog trigger) don't get Astro's scoped
     data-astro-cid-* attribute, so island-targeting classes must be
     global. -->
