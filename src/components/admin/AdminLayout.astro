---
interface Props {
  title: string;
  activeTab: 'dashboard' | 'users' | 'reports' | 'playlist';
  isAdmin: boolean;
  isMaestro: boolean;
  staffName: string;
  userRole: string;
}

const { title, activeTab, isAdmin, isMaestro, staffName, userRole } = Astro.props;
const headerLabel = isAdmin ? 'Admin' : userRole === 'firstchair' ? 'First Chair' : isMaestro ? 'Maestro' : 'Admin';

const tabs = [
  { id: 'dashboard', label: 'Dashboard', href: '/admin', show: true },
  { id: 'users', label: 'Users', href: '/admin/users', show: isAdmin },
  { id: 'reports', label: 'Reports', href: '/admin/reports', show: isAdmin || !isMaestro },
  { id: 'playlist', label: 'Playlist', href: '/admin/playlist', show: isMaestro },
].filter(t => t.show);
---
<div class="min-h-screen bg-bg">
  <!-- Admin header -->
  <div class="bg-[#1C1917] text-white px-4 md:px-6 py-3 flex items-center justify-between">
    <div class="flex items-center gap-4">
      <a href="/" class="font-display italic text-lg text-white no-underline opacity-70 hover:opacity-100">Irregular Pearl</a>
      <span class="text-xs text-white/40">|</span>
      <span class="text-sm font-medium">{headerLabel}</span>
    </div>
    <div class="flex items-center gap-3">
      <span class="text-xs text-white/60">{staffName}</span>
      <a href="/" class="text-xs text-white/40 hover:text-white no-underline">← Back to site</a>
    </div>
  </div>

  <!-- Tab nav -->
  <div class="border-b border-border bg-surface px-4 md:px-6">
    <div class="max-w-6xl mx-auto flex gap-0">
      {tabs.map(tab => (
        <a
          href={tab.href}
          class={`px-4 py-3 text-sm font-medium border-b-2 no-underline transition-colors ${
            activeTab === tab.id
              ? 'border-[#B45309] text-[#B45309]'
              : 'border-transparent text-muted hover:text-ink'
          }`}
        >
          {tab.label}
        </a>
      ))}
    </div>
  </div>

  <!-- Content -->
  <div class="max-w-6xl mx-auto px-4 md:px-6 py-6 md:py-8">
    <h1 class="font-display italic text-2xl mb-6">{title}</h1>
    <slot />
  </div>
</div>
