---
import { seedPieces } from '../data/seed';
import { supabase, hasSupabase } from '../lib/supabase';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
  hideFooter?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = 'A collaborative platform for classical music knowledge — editions, recordings, and community discussion for every piece.',
  canonical,
  jsonLd,
  ogType = 'website',
  hideFooter = false,
  noindex = false,
} = Astro.props;

const currentYear = new Date().getFullYear();

// Counts: use Supabase totals when available, fall back to seed data
let pieceCount = seedPieces.length;
let composerCount = new Set(seedPieces.map(p => p.composer_name)).size;
let editionCount = seedPieces.reduce((sum, p) => sum + p.editions.length, 0);

if (hasSupabase) {
  const [piecesRes, composersRes, editionsRes] = await Promise.allSettled([
    supabase.from('pieces').select('id', { count: 'exact', head: true }),
    supabase.from('pieces').select('composer_name').then(r => new Set((r.data || []).map((p: any) => p.composer_name)).size),
    supabase.from('editions').select('id', { count: 'exact', head: true }),
  ]);
  if (piecesRes.status === 'fulfilled' && piecesRes.value.count) pieceCount = piecesRes.value.count;
  if (composersRes.status === 'fulfilled') composerCount = composersRes.value as number;
  if (editionsRes.status === 'fulfilled' && editionsRes.value.count) editionCount = editionsRes.value.count;
}

const siteName = 'Irregular Pearl';
const fullTitle = title === 'Home' ? siteName : `${title} | ${siteName}`;
const canonicalUrl = canonical || Astro.url.href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- SEO -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />

  <!-- JSON-LD Structured Data -->
  {jsonLd && !Array.isArray(jsonLd) && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
  {jsonLd && Array.isArray(jsonLd) && jsonLd.map((ld) => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))}

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#faf8f5" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-R3S9WT1EVV"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-R3S9WT1EVV');
  </script>
</head>
<style>
  @import '../styles/global.css';
</style>
<body class="bg-bg text-ink min-h-screen font-body flex flex-col">
  <div class="flex-1">
    <slot />
  </div>
  {!hideFooter && (
    <footer class="border-t border-border py-5 px-4 md:px-6 text-xs text-muted mt-auto">
      <!-- Desktop: three columns -->
      <div class="hidden md:flex justify-between items-center">
        <div class="flex gap-4">
          <a href="/about" class="text-muted no-underline">About</a>
          <a href="/terms" class="text-muted no-underline">Terms</a>
          <a href="/privacy" class="text-muted no-underline">Privacy</a>
        </div>
        <span>© {currentYear} Irregular Pearl — a non-profit for classical music knowledge</span>
        <div>
          {pieceCount.toLocaleString()} pieces · {composerCount} composers · {editionCount}+ editions
        </div>
      </div>
      <!-- Mobile: stacked, centered -->
      <div class="flex flex-col items-center gap-2 md:hidden text-center">
        <a href="/"><img src="/logo.svg" alt="Irregular Pearl" class="h-5 w-auto" /></a>
        <a href="/about" class="text-muted no-underline">About</a>
        <a href="/terms" class="text-muted no-underline">Terms</a>
        <a href="/privacy" class="text-muted no-underline">Privacy</a>
        <div>{pieceCount.toLocaleString()} pieces · {composerCount} composers · {editionCount}+ editions</div>
        <span>© {currentYear} Irregular Pearl — a non-profit for classical music knowledge</span>
      </div>
    </footer>
  )}
</body>
</html>
